<div id="rgp-{{ sid }}" data-rgp data-currency="{{ cart.currency.iso_code }}">
  <div class="rgp-wrap">
    <nav aria-label="Ruta">
      <ol class="rgp-crumbs">
        <li><a href="{{ routes.root_url }}">Inicio</a></li>
        {%- if crumb_coll -%}<li><a href="{{ crumb_coll.url }}">{{ crumb_coll.title }}</a></li>{%- endif -%}
        <li><span aria-current="page">{{ product.title }}</span></li>
      </ol>
    </nav>

    <div class="rgp-main">
      {%- comment -%} Galería {%- endcomment -%}
      <div class="rgp-gallery" data-rgp-gallery>
        <div class="rgp-stage">
          <span class="rgp-corner rgp-corner--tl" aria-hidden="true"></span>
          <span class="rgp-corner rgp-corner--tr" aria-hidden="true"></span>
