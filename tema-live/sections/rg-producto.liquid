{%- comment -%} RacingGrip · Ficha de producto {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Condensed:ital,wght@0,700;1,800;1,900&family=Barlow:wght@400;500;600;700&family=Chakra+Petch:wght@500;600&display=swap">

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign deal = section.blocks | where: 'type', 'oferta' | first
  assign coupon = section.blocks | where: 'type', 'cupon' | first
  assign eta = section.blocks | where: 'type', 'entrega' | first

  comment
    Colección de marca = la más grande del producto, sin contar la general ni las de material.
    Colección de serie = la más pequeña distinta de la de marca.
  endcomment
  assign brand_coll = nil
  assign series_coll = nil
  assign all_count = collections.all.products_count
  for c in product.collections
    if c.handle == 'todos-los-volantes' or c.handle == 'frontpage' or c.products_count >= all_count
      continue
    endif
    if c.handle contains 'volantes-de-'
      continue
    endif
    if brand_coll == nil or c.products_count > brand_coll.products_count
      assign brand_coll = c
    endif
  endfor
  for c in product.collections
    if c.handle == 'todos-los-volantes' or c.handle == 'frontpage' or c.handle == brand_coll.handle or c.products_count >= all_count
      continue
    endif
    if c.handle contains 'volantes-de-'
      continue
    endif
    if series_coll == nil or c.products_count < series_coll.products_count
      assign series_coll = c
    endif
  endfor
  assign crumb_coll = collection | default: brand_coll

  assign desc_parts = product.description | split: '<h3>'
  assign extras_part = ''
  for part in desc_parts offset: 1
    assign part_head = part | split: '</h3>' | first | strip_html | strip | downcase
    if part_head contains 'extras'
      assign extras_part = part
    endif
  endfor
  assign extras_brand = ''
  for tag in product.tags
    if tag == 'BMW' or tag == 'Mercedes-Benz' or tag == 'Volkswagen' or tag == 'Porsche'
      assign extras_brand = tag
    endif
  endfor
  assign show_extras = true
  if deal and deal.settings.show_extras == false
    assign show_extras = false
  endif
  assign intro = desc_parts.first
-%}

<style>
  #rgp-{{ sid }}{
    --bg: {{ s.color_bg }};
    --surface: {{ s.color_surface }};
    --text: {{ s.color_text }};
    --muted: {{ s.color_muted }};
    --accent: {{ s.color_accent }};
    --kerb: {{ s.color_kerb }};
    --line: color-mix(in srgb, var(--text) 10%, transparent);
    --line-strong: color-mix(in srgb, var(--text) 18%, transparent);
    --display: "Saira Condensed","Arial Narrow",Impact,sans-serif;
    --mono: "Chakra Petch",Menlo,Consolas,monospace;
    --body: "Barlow","Helvetica Neue",Helvetica,Arial,sans-serif;
    position:relative;isolation:isolate;
    background:var(--bg);color:var(--text);font-family:var(--body);font-size:16px;line-height:1.55;
    -webkit-font-smoothing:antialiased;
    padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px;
  }
  {%- if s.show_pattern -%}
  #rgp-{{ sid }}::before{
    content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:
      radial-gradient(1100px 520px at 85% -8%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 70%),
      radial-gradient(900px 600px at -10% 40%, color-mix(in srgb, var(--kerb) 7%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px) 0 0/48px 48px,
      linear-gradient(90deg, color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px) 0 0/48px 48px;
    -webkit-mask-image:linear-gradient(to bottom,#000 0,#000 60%,transparent 100%);
    mask-image:linear-gradient(to bottom,#000 0,#000 60%,transparent 100%);
  }
  {%- endif -%}
  #rgp-{{ sid }} *,#rgp-{{ sid }} *::before,#rgp-{{ sid }} *::after{box-sizing:border-box}
  #rgp-{{ sid }} img{display:block;max-width:100%;height:auto}
  #rgp-{{ sid }} a{color:inherit}
  #rgp-{{ sid }} button,#rgp-{{ sid }} input{font:inherit;color:inherit;letter-spacing:inherit}
  #rgp-{{ sid }} :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  #rgp-{{ sid }} .rgp-wrap{max-width:{{ s.max_width }}px;margin:0 auto;padding-inline:clamp(16px,3vw,40px)}
  #rgp-{{ sid }} .rgp-vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  /* Ruta */
  #rgp-{{ sid }} .rgp-crumbs{max-width:100%;display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 clamp(18px,2.4vw,30px);padding:0;list-style:none;font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  #rgp-{{ sid }} .rgp-crumbs a{text-decoration:none}
  #rgp-{{ sid }} .rgp-crumbs a:hover{color:var(--accent)}
  #rgp-{{ sid }} .rgp-crumbs li+li::before{content:"/";margin-right:8px;color:var(--line-strong)}
  #rgp-{{ sid }} .rgp-crumbs [aria-current]{color:var(--text);max-width:40ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #rgp-{{ sid }} .rgp-crumbs li:last-child{display:flex;min-width:0;max-width:100%}
  @media (max-width:560px){#rgp-{{ sid }} .rgp-crumbs [aria-current]{max-width:calc(100vw - 48px)}}

  /* Rejilla principal */
  #rgp-{{ sid }} .rgp-main{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:clamp(28px,4.5vw,72px);align-items:start}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-main{grid-template-columns:1fr}}

  /* Galería */
  #rgp-{{ sid }} .rgp-gallery{position:sticky;top:calc(var(--header-height,72px) + 20px);display:grid;grid-template-columns:78px minmax(0,1fr);gap:14px}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-gallery{position:static;grid-template-columns:1fr}}
  #rgp-{{ sid }} .rgp-stage{
    position:relative;grid-column:2;aspect-ratio:1/1;border-radius:{{ s.radius }}px;overflow:hidden;
    background:radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--text) 13%, var(--surface)) 0%, var(--surface) 48%, color-mix(in srgb, #000 35%, var(--bg)) 100%);
    border:1px solid var(--line);
    box-shadow:0 1px 0 color-mix(in srgb, var(--text) 8%, transparent) inset, 0 40px 80px -30px rgba(0,0,0,.7);
  }
  @media (max-width:989px){#rgp-{{ sid }} .rgp-stage{grid-column:1}}
  #rgp-{{ sid }} .rgp-stage::before{
    content:"";position:absolute;inset:0;pointer-events:none;opacity:.5;
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,.028) 0 2px, transparent 2px 6px),
      repeating-linear-gradient(-45deg, rgba(0,0,0,.22) 0 2px, transparent 2px 6px);
    -webkit-mask-image:radial-gradient(circle at 50% 45%, transparent 30%, #000 75%);
    mask-image:radial-gradient(circle at 50% 45%, transparent 30%, #000 75%);
  }
  #rgp-{{ sid }} .rgp-stage::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;z-index:3;background:repeating-linear-gradient(115deg,var(--kerb) 0 22px,#EDEAE4 22px 44px)}
  #rgp-{{ sid }} .rgp-corner{position:absolute;z-index:3;width:22px;height:22px;border:2px solid var(--accent);pointer-events:none;opacity:.9}
  #rgp-{{ sid }} .rgp-corner--tl{top:16px;left:16px;border-right:0;border-bottom:0}
  #rgp-{{ sid }} .rgp-corner--tr{top:16px;right:16px;border-left:0;border-bottom:0}
  #rgp-{{ sid }} .rgp-corner--bl{bottom:24px;left:16px;border-right:0;border-top:0}
  #rgp-{{ sid }} .rgp-corner--br{bottom:24px;right:16px;border-left:0;border-top:0}
  #rgp-{{ sid }} .rgp-track{position:absolute;inset:0;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain}
  #rgp-{{ sid }} .rgp-track::-webkit-scrollbar{display:none}
  #rgp-{{ sid }} .rgp-slide{flex:0 0 100%;height:100%;scroll-snap-align:center;display:grid;place-items:center;padding:clamp(14px,4%,36px) clamp(14px,4%,36px) calc(clamp(14px,4%,36px) + 6px);margin:0;cursor:zoom-in;background:none;border:0}
  #rgp-{{ sid }} .rgp-slide img{display:block;width:100%;height:100%;min-width:0;min-height:0;max-width:none;max-height:none;object-fit:contain;border-radius:calc({{ s.radius }}px * .6);filter:drop-shadow(0 22px 30px rgba(0,0,0,.6))}
  #rgp-{{ sid }} .rgp-nav{position:absolute;top:50%;z-index:4;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;display:grid;place-items:center;cursor:pointer;background:color-mix(in srgb, var(--bg) 78%, transparent);border:1px solid var(--line-strong);color:var(--text);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);transition:background .2s,color .2s,border-color .2s}
  #rgp-{{ sid }} .rgp-nav:hover{background:var(--accent);border-color:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-nav--prev{left:16px}#rgp-{{ sid }} .rgp-nav--next{right:16px}
  #rgp-{{ sid }} .rgp-count{position:absolute;z-index:4;left:50%;bottom:22px;transform:translateX(-50%);font-family:var(--mono);font-size:12px;letter-spacing:.18em;padding:5px 12px;border-radius:999px;background:color-mix(in srgb, var(--bg) 82%, transparent);border:1px solid var(--line);font-variant-numeric:tabular-nums}
  #rgp-{{ sid }} .rgp-count b{color:var(--accent);font-weight:600}
  #rgp-{{ sid }} .rgp-zoom-hint{position:absolute;z-index:4;top:18px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--text);display:flex;gap:8px;align-items:center;opacity:.9;padding:6px 12px;border-radius:999px;background:color-mix(in srgb, var(--bg) 75%, transparent);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);white-space:nowrap}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-nav,#rgp-{{ sid }} .rgp-zoom-hint{display:none}}
  #rgp-{{ sid }} .rgp-thumbs{grid-column:1;grid-row:1;display:flex;flex-direction:column;gap:10px;max-height:min(80vh,720px);overflow-y:auto;scrollbar-width:none;padding:2px}
  #rgp-{{ sid }} .rgp-thumbs::-webkit-scrollbar{display:none}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-thumbs{grid-row:2;flex-direction:row;overflow-x:auto;max-height:none}}
  #rgp-{{ sid }} .rgp-thumb{flex:0 0 auto;width:74px;height:74px;padding:0;border-radius:6px;overflow:hidden;cursor:pointer;background:var(--surface);border:1px solid var(--line);opacity:.55;transition:opacity .2s,border-color .2s,transform .2s}
  #rgp-{{ sid }} .rgp-thumb:hover{opacity:.9}
  #rgp-{{ sid }} .rgp-thumb[aria-current="true"]{opacity:1;border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
  #rgp-{{ sid }} .rgp-thumb img{width:100%;height:100%;object-fit:cover}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-thumb{width:62px;height:62px}}

  /* Información */
  #rgp-{{ sid }} .rgp-info{display:flex;flex-direction:column;gap:22px;min-width:0}
  #rgp-{{ sid }} .rgp-coupon{display:flex;gap:14px;align-items:flex-start;margin-bottom:-4px;padding:14px 16px;border-radius:{{ s.radius }}px;border:1px solid var(--line-strong);background:color-mix(in srgb, var(--surface) 85%, transparent)}
  #rgp-{{ sid }} .rgp-coupon__ico{flex:0 0 auto;margin-top:2px;color:var(--accent)}
  #rgp-{{ sid }} .rgp-coupon__body{display:grid;gap:5px;min-width:0}
  #rgp-{{ sid }} .rgp-coupon p{margin:0}
  #rgp-{{ sid }} .rgp-coupon__t span{display:inline-block;padding:4px 10px;border-radius:4px;background:var(--accent);color:#1A1400;font-weight:800;font-size:15px;line-height:1.25;transform:skew(-6deg)}
  #rgp-{{ sid }} .rgp-coupon__x{font-size:13.5px;line-height:1.45;color:var(--muted)}
  #rgp-{{ sid }} .rgp-coupon__c{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  #rgp-{{ sid }} .rgp-coupon__c b{color:var(--text);font-size:14px;letter-spacing:.12em}
  #rgp-{{ sid }} .rgp-coupon__copy{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 10px;border-radius:999px;border:1px solid var(--line-strong);background:transparent;color:var(--text);font:600 12px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
  #rgp-{{ sid }} .rgp-coupon__copy:hover{border-color:var(--accent);color:var(--accent)}
  #rgp-{{ sid }} .rgp-coupon__copy:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  #rgp-{{ sid }} .rgp-kicker{display:flex;align-items:center;gap:12px;margin:0;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}
  #rgp-{{ sid }} .rgp-kicker::before{content:"";width:28px;height:2px;background:var(--accent)}
  #rgp-{{ sid }} .rgp-kicker a{text-decoration:none}
  #rgp-{{ sid }} .rgp-kicker a:hover{text-decoration:underline}
  #rgp-{{ sid }} .rgp-kicker span{color:var(--muted)}
  #rgp-{{ sid }} .rgp-title{margin:0;font-family:var(--display);font-style:italic;font-weight:900;text-transform:uppercase;font-size:clamp(36px,4.4vw,{{ s.title_size }}px);line-height:.92;letter-spacing:-.005em;color:var(--text);text-wrap:balance}
  #rgp-{{ sid }} .rgp-title em{font-style:inherit;color:var(--accent)}
  #rgp-{{ sid }} .rgp-intro{margin:0;color:var(--muted);font-size:17px;max-width:60ch}
  #rgp-{{ sid }} .rgp-intro p{margin:0}
  #rgp-{{ sid }} .rgp-intro strong{color:var(--text);font-weight:600}
  #rgp-{{ sid }} .rgp-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}
  #rgp-{{ sid }} .rgp-chips li{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:6px 10px;border-radius:3px;border:1px solid var(--line-strong);color:var(--muted)}

  #rgp-{{ sid }} .rgp-pricebox{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px 20px;border-radius:{{ s.radius }}px;background:color-mix(in srgb, var(--surface) 88%, transparent);border:1px solid var(--line);position:relative;overflow:hidden}
  #rgp-{{ sid }} .rgp-pricebox::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent)}
  #rgp-{{ sid }} .rgp-price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
  #rgp-{{ sid }} .rgp-price__now{font-family:var(--mono);font-weight:600;font-size:clamp(32px,3vw,40px);line-height:1;font-variant-numeric:tabular-nums}
  #rgp-{{ sid }} .rgp-price__was{font-family:var(--mono);color:var(--muted);text-decoration:line-through;font-size:18px}
  #rgp-{{ sid }} .rgp-price__save{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.1em;padding:4px 8px;border-radius:3px;background:var(--kerb);color:#fff}
  #rgp-{{ sid }} .rgp-price__tax{display:block;margin-top:6px;font-size:13px;color:var(--muted)}
  #rgp-{{ sid }} .rgp-stock{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600}
  #rgp-{{ sid }} .rgp-stock i{width:8px;height:8px;border-radius:50%;background:#3DDC84;box-shadow:0 0 0 4px color-mix(in srgb,#3DDC84 20%,transparent)}
  #rgp-{{ sid }} .rgp-stock[data-off] i{background:var(--kerb);box-shadow:0 0 0 4px color-mix(in srgb,var(--kerb) 20%,transparent)}

  #rgp-{{ sid }} .rgp-options{display:flex;flex-direction:column;gap:20px}
  #rgp-{{ sid }} .rgp-eta{margin:0 0 22px;padding:16px clamp(12px,2vw,18px) 18px;border-radius:{{ s.radius }}px;border:1px solid var(--line-strong);background:color-mix(in srgb, var(--surface) 80%, transparent)}
  #rgp-{{ sid }} .rgp-eta__head{margin:0 0 16px;font-size:15px;line-height:1.4;color:var(--text)}
  #rgp-{{ sid }} .rgp-eta__head b{color:var(--accent);font-family:var(--mono);font-weight:600;white-space:nowrap}
  #rgp-{{ sid }} .rgp-eta__steps{display:flex;align-items:flex-start;margin:0;padding:0;list-style:none}
  #rgp-{{ sid }} .rgp-eta__step{flex:0 0 auto;width:30%;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;font-size:12.5px;line-height:1.3;color:var(--muted)}
  #rgp-{{ sid }} .rgp-eta__step b{margin-top:6px;font-size:13.5px;font-weight:700;color:var(--text)}
  #rgp-{{ sid }} .rgp-eta__ico{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:color-mix(in srgb, var(--accent) 14%, transparent);color:var(--text)}
  #rgp-{{ sid }} .rgp-eta__step[data-on] .rgp-eta__ico{background:var(--accent);color:#1A1400;box-shadow:0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent)}
  #rgp-{{ sid }} .rgp-eta__line{flex:1;min-width:14px;height:50px;display:flex;align-items:center;margin:0 -6%}
  #rgp-{{ sid }} .rgp-eta__line i{display:block;width:100%;height:2px;background:repeating-linear-gradient(90deg,var(--accent) 0 8px,transparent 8px 16px);background-size:16px 2px;animation:rgp-eta-{{ sid }} .9s linear infinite;opacity:.85}
  @keyframes rgp-eta-{{ sid }}{to{background-position:16px 0}}
  @media (prefers-reduced-motion:reduce){#rgp-{{ sid }} .rgp-eta__line i{animation:none}}
  @media (max-width:420px){#rgp-{{ sid }} .rgp-eta__ico{width:42px;height:42px}#rgp-{{ sid }} .rgp-eta__line{height:42px}}
  #rgp-{{ sid }} .rgp-option{border:0;margin:0;padding:0;min-width:0}
  #rgp-{{ sid }} .rgp-option legend{display:flex;gap:10px;align-items:baseline;padding:0;margin:0 0 12px;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
  #rgp-{{ sid }} .rgp-option legend b{font-family:var(--body);font-size:15px;letter-spacing:0;text-transform:none;color:var(--text)}
  #rgp-{{ sid }} .rgp-pills{display:flex;flex-wrap:wrap;gap:8px}
  #rgp-{{ sid }} .rgp-pill{position:relative}
  #rgp-{{ sid }} .rgp-pill input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  #rgp-{{ sid }} .rgp-pill span{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:10px 18px;border-radius:4px;border:1px solid var(--line-strong);background:color-mix(in srgb, var(--surface) 80%, transparent);font-weight:600;font-size:15px;transition:border-color .15s,background .15s,color .15s;cursor:pointer}
  #rgp-{{ sid }} .rgp-pill:hover span{border-color:color-mix(in srgb, var(--accent) 60%, transparent)}
  #rgp-{{ sid }} .rgp-pill input:checked + span{background:var(--accent);border-color:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-pill input:focus-visible + span{outline:2px solid var(--accent);outline-offset:3px}
  #rgp-{{ sid }} .rgp-pill .rgp-dot{width:12px;height:12px;border-radius:50%;border:1px solid rgba(255,255,255,.35)}

  #rgp-{{ sid }} .rgp-deal{position:relative;margin:14px 0 20px;padding:28px 14px 14px;border-radius:{{ s.radius }}px;border:2px solid var(--deal);background:color-mix(in srgb, var(--deal) 10%, var(--surface));box-shadow:0 0 0 4px color-mix(in srgb, var(--deal) 14%, transparent),0 22px 44px -26px color-mix(in srgb, var(--deal) 80%, transparent)}
  #rgp-{{ sid }} .rgp-deal__head{position:absolute;top:0;left:50%;transform:translate(-50%,-50%);margin:0;display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:var(--deal);color:#fff;font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;box-shadow:0 8px 20px -8px var(--deal)}
  #rgp-{{ sid }} .rgp-deal__head i{width:8px;height:8px;border-radius:50%;background:#fff;animation:rgp-pulse-{{ sid }} 1.6s ease-out infinite}
  @keyframes rgp-pulse-{{ sid }}{0%{box-shadow:0 0 0 0 rgba(255,255,255,.8)}100%{box-shadow:0 0 0 9px rgba(255,255,255,0)}}
  #rgp-{{ sid }} .rgp-deal__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  #rgp-{{ sid }} .rgp-deal__opt{position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;padding:22px 6px 14px;border-radius:calc({{ s.radius }}px * .8);border:1px solid var(--line-strong);background:var(--bg);color:var(--text);font:inherit;text-align:center;cursor:pointer;transition:border-color .2s,background .2s,transform .2s}
  #rgp-{{ sid }} .rgp-deal__opt:hover{border-color:var(--deal);transform:translateY(-2px)}
  #rgp-{{ sid }} .rgp-deal__opt:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  #rgp-{{ sid }} .rgp-deal__opt[aria-pressed="true"]{border-color:var(--deal);background:color-mix(in srgb, var(--deal) 20%, var(--bg));box-shadow:inset 0 0 0 1px var(--deal)}
