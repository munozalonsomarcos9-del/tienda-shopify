          <span class="rgp-corner rgp-corner--br" aria-hidden="true"></span>
          {%- if product.media.size > 0 -%}
            <div class="rgp-track" data-rgp-track tabindex="0" aria-label="Fotos de {{ product.title | escape }}">
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <button type="button" class="rgp-slide" data-rgp-slide data-media-id="{{ media.id }}" data-full="{{ media | image_url: width: 2000 }}" aria-label="Ampliar foto {{ forloop.index }}">
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, fetchpriority: 'high' }}
                    {%- else -%}
                      {{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, loading: 'lazy' }}
                    {%- endif -%}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if product.media.size > 1 -%}
              <span class="rgp-zoom-hint" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4M11 8v6M8 11h6"/></svg>{{ s.zoom_hint }}
              </span>
              <button type="button" class="rgp-nav rgp-nav--prev" data-rgp-prev aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
              <button type="button" class="rgp-nav rgp-nav--next" data-rgp-next aria-label="Foto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
              <span class="rgp-count" aria-live="polite"><b data-rgp-idx>01</b> / {{ product.media.size | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
          {%- else -%}
            <div class="rgp-track"><div class="rgp-slide">{{ 'product-1' | placeholder_svg_tag }}</div></div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="rgp-thumbs" role="group" aria-label="Miniaturas">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="rgp-thumb" data-rgp-thumb aria-label="Ver foto {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Información y compra {%- endcomment -%}
      <div class="rgp-info">
        {%- if coupon and coupon.settings.code != blank -%}
          {%- assign cs = coupon.settings -%}
          <div class="rgp-coupon" {{ coupon.shopify_attributes }}>
            <svg class="rgp-coupon__ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
            <div class="rgp-coupon__body">
              <p class="rgp-coupon__t"><span>{{ cs.title }}</span></p>
              {%- if cs.text != blank -%}<p class="rgp-coupon__x">{{ cs.text }}</p>{%- endif -%}
              <p class="rgp-coupon__c">Código: <b class="notranslate" translate="no">{{ cs.code }}</b>
                <button type="button" class="rgp-coupon__copy" data-rgp-coupon="{{ cs.code | escape }}" aria-label="Copiar el código {{ cs.code | escape }}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>
                  <span data-rgp-coupon-label>Copiar</span>
                </button>
              </p>
            </div>
          </div>
        {%- endif -%}
        <div style="display:flex;flex-direction:column;gap:14px">
          {%- if brand_coll -%}
            <p class="rgp-kicker"><a href="{{ brand_coll.url }}">{{ brand_coll.title }}</a>{%- if series_coll -%}<span>·</span><a href="{{ series_coll.url }}">{{ series_coll.title | remove: brand_coll.title | strip | default: series_coll.title }}</a>{%- endif -%}</p>
          {%- endif -%}
          {%- assign title_parts = product.title | split: ' · ' -%}
          <h1 class="rgp-title">
            {%- if title_parts.size > 1 -%}{{ title_parts.first }} <em>{{ title_parts.last }}</em>{%- else -%}{{ product.title }}{%- endif -%}
          </h1>
        </div>

        {%- if s.show_intro and intro != blank -%}
          <div class="rgp-intro">{{ intro }}</div>
        {%- endif -%}

        {%- if s.show_chips -%}
          <ul class="rgp-chips" aria-label="Características">
            {%- for tag in product.tags -%}
              {%- unless tag == 'Volante' -%}<li>{{ tag }}</li>{%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="rgp-pricebox">
          <div>
            <div class="rgp-price">
              <span class="rgp-price__now" data-rgp-price>{{ current.price | money }}</span>
              <s class="rgp-price__was" data-rgp-was {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{{ current.compare_at_price | money }}</s>
              <span class="rgp-price__save" data-rgp-save {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{%- if current.compare_at_price > current.price -%}−{{ current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round }}%{%- endif -%}</span>
            </div>
            <span class="rgp-price__extras" data-rgp-extras-line hidden></span>
            <span class="rgp-price__tax">{{ s.tax_text }}</span>
          </div>
          <span class="rgp-stock" data-rgp-stock {% unless current.available %}data-off{% endunless %}><i aria-hidden="true"></i><span data-rgp-stock-label>{% if current.available %}{{ s.available_text }}{% else %}Agotado{% endif %}</span></span>
        </div>

        {%- if eta -%}{%- render 'rg-entrega', eta: eta -%}{%- endif -%}

        {%- assign form_id = 'rgp-form-' | append: sid -%}
        {%- form 'product', product, id: form_id, class: 'rgp-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-rgp-id>

          {%- unless product.has_only_default_variant -%}
            <div class="rgp-options" style="margin-bottom:22px">
              {%- for option in product.options_with_values -%}
                <fieldset class="rgp-option" data-rgp-option>
                  <legend>{{ option.name }} <b data-rgp-selected>{{ option.selected_value }}</b></legend>
                  <div class="rgp-pills">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign dot = ''
                        assign lv = value | downcase
                        if lv contains 'forjado'
                          assign dot = 'radial-gradient(circle at 30% 30%,#5a5d61 0 18%,transparent 19%),radial-gradient(circle at 70% 65%,#44474b 0 22%,transparent 23%),#141516'
                        elsif lv contains 'pantalla'
                          assign dot = 'radial-gradient(circle,#FFC21A 0 38%,#1A1B1D 44%)'
                        elsif lv contains 'roj'
                          assign dot = '#D8342A'
                        elsif lv contains 'azul'
                          assign dot = '#2D6BD8'
                        elsif lv contains 'blanc'
                          assign dot = '#F1EFEA'
                        elsif lv contains 'amarill'
                          assign dot = '#FFC21A'
                        elsif lv contains 'beige'
                          assign dot = '#D9C7A6'
                        elsif lv contains 'burdeos'
                          assign dot = '#6E1E2B'
                        elsif lv contains 'marrón'
                          assign dot = '#6B4226'
                        elsif lv contains 'gris'
                          assign dot = '#8A9097'
                        elsif lv contains 'carbono' or lv contains 'fibra'
                          assign dot = 'repeating-linear-gradient(45deg,#3a3c3f 0 2px,#141516 2px 4px)'
                        elsif lv contains 'alcántara'
                          assign dot = '#4A4C4F'
                        elsif lv contains 'negr'
                          assign dot = '#0B0B0C'
                        elsif lv contains 'cromado' or lv contains 'aluminio'
                          assign dot = 'linear-gradient(135deg,#F4F5F6,#9DA3AA)'
                        endif
                      -%}
                      <label class="rgp-pill">
                        <input type="radio" name="rgp-{{ sid }}-opt-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span>{%- if dot != '' -%}<i class="rgp-dot" style="background:{{ dot }}" aria-hidden="true"></i>{%- endif -%}{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- if show_extras and extras_part != '' -%}
            {%- capture extras_cards -%}{%- render 'rg-extras', part: extras_part, brand: extras_brand -%}{%- endcapture -%}
            {%- if extras_cards contains 'data-rgp-extra' -%}
              <fieldset class="rgp-extras" data-rgp-extras>
                <legend>{{ deal.settings.extras_title | default: 'Personaliza tu volante' }}</legend>
                <p class="rgp-extras__sub">{{ deal.settings.extras_text | default: 'Pulsa para añadir. Se suman al precio al instante.' }}</p>
                <div class="rgp-extras__grid">{{ extras_cards }}</div>
              </fieldset>
            {%- endif -%}
          {%- endif -%}

          {%- if deal and deal.settings.show -%}
            {%- assign ds = deal.settings -%}
            <div class="rgp-deal" data-rgp-deal style="--deal:{{ ds.color_deal }}" {{ deal.shopify_attributes }}>
              <p class="rgp-deal__head"><i aria-hidden="true"></i>{{ ds.title }}</p>
              <div class="rgp-deal__grid" role="group" aria-label="{{ ds.title | escape }}">
                {%- for n in (1..3) -%}
                  {%- liquid
                    assign pct = 0
                    if n == 2
                      assign pct = ds.pct_2
                    elsif n == 3
                      assign pct = ds.pct_3
                    endif
                    assign full = current.price | times: n
                    assign keep = 100 | minus: pct
                    assign now = full | times: keep | divided_by: 100
                  -%}
                  <button type="button" class="rgp-deal__opt" data-rgp-pack="{{ n }}" data-pct="{{ pct }}" aria-pressed="{% if n == 1 %}true{% else %}false{% endif %}">
                    {%- if n == 2 and ds.badge_2 != blank -%}<span class="rgp-deal__tag">{{ ds.badge_2 }}</span>{%- elsif n == 3 and ds.badge_3 != blank -%}<span class="rgp-deal__tag">{{ ds.badge_3 }}</span>{%- endif -%}
                    <span class="rgp-deal__icons">{%- for i in (1..n) -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M3.5 10.5l6 1M20.5 10.5l-6 1M12 14.5V21"/></svg>{%- endfor -%}</span>
                    <b class="rgp-deal__n">{% if n == 1 %}1 volante{% elsif n == 2 %}2 volantes{% else %}3 o más{% endif %}</b>
                    {%- if pct > 0 -%}
                      <span class="rgp-deal__save">Ahorras {{ pct }}%</span>
                    {%- else -%}
                      <span class="rgp-deal__save rgp-deal__save--off">Precio normal</span>
                    {%- endif -%}
                    <span class="rgp-deal__now" data-rgp-pack-now>{{ now | money }}</span>
                    {%- if pct > 0 -%}<s class="rgp-deal__was" data-rgp-pack-was>{{ full | money }}</s>{%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
              {%- if ds.note != blank -%}<p class="rgp-deal__note">{{ ds.note }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          <details class="rgp-vinf" data-rgp-vinf>
            <summary>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h4M7 14h7M16 10h1"/></svg>
              <span>Añadir número de bastidor (VIN) <em>· opcional</em></span>
              <i aria-hidden="true">+</i>
            </summary>
            <div class="rgp-vinf__body">
              <label for="rgp-vin-{{ sid }}">Lo encontrarás en el permiso de circulación (casilla E). Así comprobamos que el volante es 100 % compatible antes de fabricarlo.</label>
              <input id="rgp-vin-{{ sid }}" type="text" name="properties[Número de bastidor (VIN)]" maxlength="24" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Ej.: WBA8E9C50GK123456" data-rgp-vin>
              <small data-rgp-vin-msg></small>
            </div>
          </details>

          <div class="rgp-buy">
            <div class="rgp-buy__row">
              <div class="rgp-qty">
                <button type="button" data-rgp-step="-1" aria-label="Quitar uno">−</button>
                <label class="rgp-vh" for="rgp-qty-{{ sid }}">Cantidad</label>
                <input id="rgp-qty-{{ sid }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                <button type="button" data-rgp-step="1" aria-label="Añadir uno">+</button>
              </div>
              <button class="rgp-btn rgp-btn--primary" type="submit" name="add" data-rgp-add data-label="{{ s.add_label | escape }}" {% unless current.available %}disabled{% endunless %}>
                <span data-rgp-add-label>{%- if current.available -%}{{ s.add_label }}{%- else -%}Agotado{%- endif -%}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            {%- if s.show_buy_now -%}{{ form | payment_button }}{%- endif -%}
          </div>
        {%- endform -%}

        {%- if deal and deal.settings.ship_title != blank -%}
          <div class="rgp-ship">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
            <div><b>{{ deal.settings.ship_title }}</b>{%- if deal.settings.ship_text != blank -%}<span>{{ deal.settings.ship_text }}</span>{%- endif -%}</div>
          </div>
        {%- endif -%}

        {%- if s.show_pay -%}
          <div class="rgp-pay">
            <span class="rgp-pay__t"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>{{ s.pay_title }}</span>
            {%- render 'rg-pagos', s: s, types: s.pay_types -%}
          </div>
        {%- endif -%}

        {%- if s.vin_title != blank -%}
          <div class="rgp-vin">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-4z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            <div><b>{{ s.vin_title }}</b>{%- if s.vin_text != blank -%}<p>{{ s.vin_text }}</p>{%- endif -%}</div>
          </div>
        {%- endif -%}

        {%- if s.show_trust -%}
          <ul class="rgp-trust">
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M3.5 10.5l6 1M20.5 10.5l-6 1M12 14.5V21"/></svg><b>{{ s.trust_1_title }}</b><span>{{ s.trust_1_text }}</span></li>
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg><b>{{ s.trust_2_title }}</b><span>{{ s.trust_2_text }}</span></li>
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><b>{{ s.trust_3_title }}</b><span>{{ s.trust_3_text }}</span></li>
          </ul>
        {%- endif -%}

        <span class="rgp-sku" data-rgp-sku>{% if current.sku != blank %}REF. {{ current.sku }}{% endif %}</span>
      </div>
    </div>

    {%- comment -%} Detalles: cada bloque «h3» de la descripción se convierte en un desplegable {%- endcomment -%}
    {%- if desc_parts.size > 1 -%}
      <section class="rgp-details" data-rgp-reveal aria-labelledby="rgp-det-{{ sid }}">
        <div class="rgp-details__side">
          <p class="rgp-kicker">{{ s.details_kicker }}</p>
          <h2 class="rgp-h2" id="rgp-det-{{ sid }}">{{ s.details_title }}</h2>
          {%- if s.details_text != blank -%}<p>{{ s.details_text }}</p>{%- endif -%}
        </div>
        <div class="rgp-acc">
          {%- assign acc_n = 0 -%}
          {%- for part in desc_parts offset: 1 -%}
            {%- assign bits = part | split: '</h3>' -%}
            {%- assign heading = bits.first | strip_html | strip -%}
            {%- assign heading_l = heading | downcase -%}
            {%- if heading_l contains 'extras' and extras_cards contains 'data-rgp-extra' -%}{%- continue -%}{%- endif -%}
            {%- assign acc_n = acc_n | plus: 1 -%}
            {%- assign body = part | remove_first: bits.first | remove_first: '</h3>' -%}
            <details {% if acc_n == 1 and s.open_first %}open{% endif %}>
              <summary>
                <span class="rgp-acc__n">{{ acc_n | prepend: '0' | slice: -2, 2 }}</span>
                <span class="rgp-acc__t">{{ heading }}</span>
                <span class="rgp-acc__i" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <div class="rgp-acc__body">{{ body }}</div>
            </details>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} Relacionados de la misma marca {%- endcomment -%}
    {%- if s.show_related and brand_coll and brand_coll.products_count > 1 -%}
      <section class="rgp-related" data-rgp-reveal aria-labelledby="rgp-rel-{{ sid }}">
        <div class="rgp-related__head">
          <div>
            <p class="rgp-kicker">{{ s.related_kicker }}</p>
            <h2 class="rgp-h2" id="rgp-rel-{{ sid }}">{{ s.related_title | replace: '[marca]', brand_coll.title }}</h2>
          </div>
          <a class="rgp-link" href="{{ brand_coll.url }}">Ver todos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="rgp-grid">
          {%- assign shown = 0 -%}
          {%- for p in brand_coll.products -%}
            {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= s.related_count -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="rgp-card" href="{{ p.url }}">
              <div class="rgp-card__img">
                {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', alt: p.title }}{%- endif -%}
              </div>
              <div class="rgp-card__body">
                <h3 class="rgp-card__t">{{ p.title }}</h3>
                <span class="rgp-card__p">{%- if p.price_varies -%}<small>Desde</small>{%- endif -%}{{ p.price_min | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>

  {%- if s.show_sticky -%}
    <div class="rgp-sticky" data-rgp-sticky aria-hidden="true">
      <div class="rgp-wrap rgp-sticky__in">
        {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        <div class="rgp-sticky__t"><b>{{ product.title }}</b><span data-rgp-sticky-price>{{ current.price | money }}</span></div>
        <button type="button" class="rgp-btn rgp-btn--primary" data-rgp-sticky-btn tabindex="-1">{{ s.add_label }}</button>
      </div>
    </div>
  {%- endif -%}

  <dialog class="rgp-lightbox" data-rgp-lightbox aria-label="Foto ampliada">
    <div class="rgp-lightbox__in">
      <button type="button" class="rgp-close" data-rgp-close aria-label="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      <button type="button" class="rgp-nav rgp-nav--prev" data-rgp-lb-prev aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
      <img data-rgp-lb-img alt="" width="1600" height="1600">
      <button type="button" class="rgp-nav rgp-nav--next" data-rgp-lb-next aria-label="Foto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </dialog>

  <script type="application/json" data-rgp-variants>{{ product.variants | json }}</script>
</div>

<script>
(() => {
  const root = document.getElementById('rgp-{{ sid }}');
  if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  const $ = (q, el = root) => el.querySelector(q);
  const $$ = (q, el = root) => [...el.querySelectorAll(q)];
  const pad = n => String(n).padStart(2, '0');
  const fmt = cents => {
    try { return new Intl.NumberFormat(document.documentElement.lang || 'es', { style: 'currency', currency: root.dataset.currency || 'EUR' }).format(cents / 100); }
    catch (e) { return (cents / 100).toFixed(2) + ' €'; }
  };

  /* Galería */
  const track = $('[data-rgp-track]');
  const slides = $$('[data-rgp-slide]');
  const thumbs = $$('[data-rgp-thumb]');
  const idxEl = $('[data-rgp-idx]');
  let cur = 0;
  const go = (n, smooth = true) => {
    if (!slides.length) return;
    cur = (n + slides.length) % slides.length;
    track.scrollTo({ left: slides[cur].offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
  };
  const mark = n => {
    cur = n;
    thumbs.forEach((t, k) => t.setAttribute('aria-current', k === n));
    if (idxEl) idxEl.textContent = pad(n + 1);
    const t = thumbs[n]; if (t) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };
  if (track && slides.length > 1) {
    let raf;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => mark(Math.round(track.scrollLeft / track.clientWidth))); }, { passive: true });
    $('[data-rgp-prev]')?.addEventListener('click', () => go(cur - 1));
    $('[data-rgp-next]')?.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    track.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); } if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); } });
  }
  const showMedia = id => { const k = slides.findIndex(s => s.dataset.mediaId === String(id)); if (k >= 0) go(k); };

  /* Visor ampliado */
  const lb = $('[data-rgp-lightbox]'); const lbImg = $('[data-rgp-lb-img]');
  let lbI = 0;
  const lbShow = n => { lbI = (n + slides.length) % slides.length; const s = slides[lbI]; lbImg.src = s.dataset.full; lbImg.alt = s.querySelector('img')?.alt || ''; };
  if (lb && lb.showModal) {
    slides.forEach((s, k) => s.addEventListener('click', () => { lbShow(k); lb.showModal(); }));
    $('[data-rgp-close]').addEventListener('click', () => lb.close());
    $('[data-rgp-lb-prev]').addEventListener('click', () => lbShow(lbI - 1));
    $('[data-rgp-lb-next]').addEventListener('click', () => lbShow(lbI + 1));
    lb.addEventListener('click', e => { if (e.target === lb || e.target.classList.contains('rgp-lightbox__in')) lb.close(); });
    lb.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') lbShow(lbI - 1); if (e.key === 'ArrowRight') lbShow(lbI + 1); });
    lb.addEventListener('close', () => go(lbI, false));
  }

  /* Variantes */
  const variants = JSON.parse($('[data-rgp-variants]').textContent);
  const form = $('form[action*="/cart/add"]');
  const idInput = $('[data-rgp-id]');
  const fieldsets = $$('[data-rgp-option]');
  const addBtn = $('[data-rgp-add]'); const addLabel = $('[data-rgp-add-label]');
  const priceEl = $('[data-rgp-price]'), wasEl = $('[data-rgp-was]'), saveEl = $('[data-rgp-save]');
  const stockEl = $('[data-rgp-stock]'), stockLabel = $('[data-rgp-stock-label]');
  const skuEl = $('[data-rgp-sku]'), stickyPrice = $('[data-rgp-sticky-price]'), stickyBtn = $('[data-rgp-sticky-btn]');
  const availText = {{ s.available_text | json }};
  let unit = {{ current.price | json }};
  let curV = variants.find(x => String(x.id) === String(idInput.value)) || variants[0];
  /* Extras opcionales: se suman al precio al instante */
  const extraInputs = $$('[data-rgp-extra]'), extrasLine = $('[data-rgp-extras-line]');
  const chosenExtras = () => extraInputs.filter(i => i.checked);
  const extrasSum = () => chosenExtras().reduce((a, i) => a + (+i.dataset.price || 0), 0);
  function paintPrice() {
    if (!curV) return;
    const ex = extrasSum(), total = curV.price + ex;
    priceEl.textContent = fmt(total);
    if (stickyPrice) stickyPrice.textContent = fmt(total);
    const sale = curV.compare_at_price > curV.price;
    wasEl.hidden = !sale; saveEl.hidden = !sale;
    if (sale) { wasEl.textContent = fmt(curV.compare_at_price + ex); saveEl.textContent = '−' + Math.round((curV.compare_at_price - curV.price) * 100 / curV.compare_at_price) + '%'; }
    const list = chosenExtras();
    if (extrasLine) {
      extrasLine.hidden = !list.length;
      extrasLine.innerHTML = list.length ? '<b>' + fmt(curV.price) + '</b> + ' + list.map(i => i.dataset.name + ' (+' + fmt(+i.dataset.price) + ')').join(' · ') : '';
    }
    if (form) form.toggleAttribute('data-has-extras', list.length > 0);
    paintPacks();
  }
  extraInputs.forEach(i => i.addEventListener('change', paintPrice));
  const update = () => {
    const opts = fieldsets.map(fs => fs.querySelector('input:checked')?.value);
    fieldsets.forEach((fs, k) => { const l = fs.querySelector('[data-rgp-selected]'); if (l) l.textContent = opts[k] || ''; });
    const v = variants.find(v => v.options.every((o, k) => o === opts[k]));
    if (!v) { addBtn.disabled = true; addLabel.textContent = 'No disponible'; if (stickyBtn) stickyBtn.disabled = true; return; }
    idInput.value = v.id;
    curV = v; unit = v.price; paintPrice();
    addBtn.disabled = !v.available; addLabel.textContent = v.available ? addBtn.dataset.label : 'Agotado';
    if (stickyBtn) stickyBtn.disabled = !v.available;
    stockEl.toggleAttribute('data-off', !v.available); stockLabel.textContent = v.available ? availText : 'Agotado';
    skuEl.textContent = v.sku ? 'REF. ' + v.sku : '';
    if (v.featured_media) showMedia(v.featured_media.id);
    const url = new URL(location.href); url.searchParams.set('variant', v.id); history.replaceState({}, '', url);
  };
  fieldsets.forEach(fs => fs.addEventListener('change', update));
  /* Al abrir la página, la galería empieza en la foto de la versión elegida */
  const startV = variants.find(v => String(v.id) === String(idInput.value));
  if (startV && startV.featured_media) {
    const k = slides.findIndex(s => s.dataset.mediaId === String(startV.featured_media.id));
    if (k > 0) requestAnimationFrame(() => { track.scrollTo({ left: slides[k].offsetLeft, behavior: 'auto' }); mark(k); });
  }

  /* Cantidad */
  const q = $('.rgp-qty input');
  $$('[data-rgp-step]').forEach(b => b.addEventListener('click', () => { q.value = Math.max(1, (parseInt(q.value, 10) || 1) + parseInt(b.dataset.rgpStep, 10)); markPack(); }));
  q.addEventListener('input', () => markPack());

  /* Oferta por cantidad: 1, 2 o 3 volantes */
  const packs = $$('[data-rgp-pack]');
  function paintPacks() {
    packs.forEach(b => {
      const n = +b.dataset.rgpPack, pct = +b.dataset.pct || 0, ex = extrasSum();
      b.querySelector('[data-rgp-pack-now]').textContent = fmt(Math.floor(unit * n * (100 - pct) / 100) + ex * n);
      const was = b.querySelector('[data-rgp-pack-was]'); if (was) was.textContent = fmt((unit + ex) * n);
    });
  }
  function markPack() {
    const n = Math.min(3, Math.max(1, parseInt(q.value, 10) || 1));
    packs.forEach(b => b.setAttribute('aria-pressed', String(+b.dataset.rgpPack === n)));
  }
  packs.forEach(b => b.addEventListener('click', () => { q.value = b.dataset.rgpPack; markPack(); }));

  /* Número de bastidor (opcional): mayúsculas, sin espacios, y aviso si no tiene 17 caracteres */
  const vinInput = root.querySelector('[data-rgp-vin]');
  const vinMsg = root.querySelector('[data-rgp-vin-msg]');
  if (vinInput) vinInput.addEventListener('input', () => {
    const v = vinInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 17);
    if (v !== vinInput.value) vinInput.value = v;
    if (!vinMsg) return;
    if (!v) { vinMsg.textContent = ''; vinMsg.removeAttribute('data-ok'); }
    else if (v.length === 17) { vinMsg.textContent = '✓ Bastidor completo'; vinMsg.setAttribute('data-ok', ''); }
    else { vinMsg.textContent = v.length + ' de 17 caracteres'; vinMsg.removeAttribute('data-ok'); }
  });

  /* Plazo de entrega: cuenta atrás hasta la hora de corte y fechas calculadas desde hoy */
  const eta = root.querySelector('[data-rgp-eta]');
  if (eta) {
    const M = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    const add = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
    const S = ['ene','feb','mar','abr','may','jun','jul','ago','sept','oct','nov','dic'];
    const range = (a, b) => a.getMonth() === b.getMonth()
      ? `${a.getDate()}–${b.getDate()} ${S[b.getMonth()]}`
      : `${a.getDate()} ${S[a.getMonth()]} – ${b.getDate()} ${S[b.getMonth()]}`;
    const between = (a, b) => a.getMonth() === b.getMonth()
      ? `el ${a.getDate()} y el ${b.getDate()} de ${M[b.getMonth()]}`
      : `el ${a.getDate()} de ${M[a.getMonth()]} y el ${b.getDate()} de ${M[b.getMonth()]}`;
    const cut = (eta.dataset.cutoff || '23:59').split(':').map(Number);
    const head = eta.querySelector('[data-rgp-eta-head]');
    const d2 = eta.querySelector('[data-rgp-eta-d2]'), d3 = eta.querySelector('[data-rgp-eta-d3]');
    const paintEta = () => {
      const now = new Date();
      let limit = new Date(now); limit.setHours(cut[0] || 0, cut[1] || 0, 0, 0);
      let base = new Date(now);
      if (limit <= now) { limit = add(limit, 1); base = add(base, 1); }
      const mins = Math.max(1, Math.ceil((limit - now) / 60000));
      const h = Math.floor(mins / 60), m = mins % 60;
      const left = (h ? h + ' h ' : '') + String(m).padStart(h ? 2 : 1, '0') + ' min';
      const sMin = add(base, +eta.dataset.shipMin), sMax = add(base, +eta.dataset.shipMax);
      const dMin = add(base, +eta.dataset.delMin), dMax = add(base, +eta.dataset.delMax);
      d2.textContent = range(sMin, sMax);
      d3.textContent = range(dMin, dMax);
      head.innerHTML = `Si lo pides en las próximas <b>${left}</b>, te llega entre <b>${between(dMin, dMax)}</b>`;
    };
    paintEta(); setInterval(paintEta, 30000);
  }

  /* Cupón de primer pedido: copiar el código */
  root.querySelectorAll('[data-rgp-coupon]').forEach(b => b.addEventListener('click', async () => {
    const code = b.dataset.rgpCoupon, lbl = b.querySelector('[data-rgp-coupon-label]');
    try { await navigator.clipboard.writeText(code); } catch (e) {
      const t = document.createElement('textarea'); t.value = code; document.body.appendChild(t); t.select(); try { document.execCommand('copy'); } catch (_) {} t.remove();
    }
    lbl.textContent = '¡Copiado!'; setTimeout(() => { lbl.textContent = 'Copiar'; }, 1800);
  }));

  /* Con extras elegidos, el volante y sus extras entran juntos en el carrito */
  if (form) form.addEventListener('submit', async (e) => {
    const list = chosenExtras();
    if (!list.length) return;
    e.preventDefault();
    const qty = Math.max(1, parseInt(q.value, 10) || 1);
    const wheel = {{ product.title | json }} + (curV && curV.title && curV.title !== 'Default Title' ? ' · ' + curV.title : '');
    const wheelProps = { 'Extras': list.map(i => i.dataset.name).join(', ') };
    if (vinInput && vinInput.value.trim()) wheelProps['Número de bastidor (VIN)'] = vinInput.value.trim();
    const items = [{ id: +idInput.value, quantity: qty, properties: wheelProps }]
      .concat(list.map(i => ({ id: +i.value, quantity: qty, properties: { 'Para': wheel } })));
    const label = addLabel.textContent; addBtn.disabled = true; addLabel.textContent = 'Añadiendo…';
    try {
      const r = await fetch({{ routes.cart_add_url | json }} + '.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items }) });
      if (!r.ok) { const d = await r.json().catch(() => ({})); throw new Error(d.description || d.message || 'Error'); }
      location.href = {{ routes.cart_url | json }};
    } catch (err) {
      addBtn.disabled = false; addLabel.textContent = label;
      alert('No se ha podido añadir al carrito: ' + err.message);
    }
  });

  /* Barra fija */
  const sticky = $('[data-rgp-sticky]');
  if (sticky && addBtn) {
    const buy = $('.rgp-buy');
    let shown = null, tick = false;
    const check = () => {
      tick = false;
      const show = buy.getBoundingClientRect().bottom < 0;
      if (show === shown) return; shown = show;
      sticky.toggleAttribute('data-show', show); sticky.setAttribute('aria-hidden', !show);
      stickyBtn.tabIndex = show ? 0 : -1;
    };
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(check); } }, { passive: true });
    addEventListener('resize', check); check();
    stickyBtn.addEventListener('click', () => { if (form.requestSubmit) form.requestSubmit(addBtn); else addBtn.click(); });
  }

  /* Entrada animada */
  const rev = $$('[data-rgp-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    rev.forEach(el => io.observe(el));
  } else rev.forEach(el => el.classList.add('is-in'));
})();
</script>

