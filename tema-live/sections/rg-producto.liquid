{%- comment -%} RacingGrip · Ficha de producto {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Condensed:ital,wght@0,700;1,800;1,900&family=Barlow:wght@400;500;600;700&family=Chakra+Petch:wght@500;600&display=swap">

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign first_media = current.featured_media | default: product.featured_media

  comment
    Colección de marca = la más grande del producto, sin contar la general ni las de material.
    Colección de serie = la más pequeña distinta de la de marca.
  endcomment
  assign brand_coll = nil
  assign series_coll = nil
  for c in product.collections
    if c.handle == 'todos-los-volantes' or c.handle == 'frontpage'
      continue
    endif
    if c.handle contains 'volantes-de-'
      continue
    endif
    if brand_coll == nil or c.products_count > brand_coll.products_count
      assign brand_coll = c
    endif
  endfor
  for c in product.collections
    if c.handle == 'todos-los-volantes' or c.handle == 'frontpage' or c.handle == brand_coll.handle
      continue
    endif
    if c.handle contains 'volantes-de-'
      continue
    endif
    if series_coll == nil or c.products_count < series_coll.products_count
      assign series_coll = c
    endif
  endfor
  assign crumb_coll = collection | default: brand_coll

  assign desc_parts = product.description | split: '<h3>'
  assign intro = desc_parts.first
-%}

<style>
  #rgp-{{ sid }}{
    --bg: {{ s.color_bg }};
    --surface: {{ s.color_surface }};
    --text: {{ s.color_text }};
    --muted: {{ s.color_muted }};
    --accent: {{ s.color_accent }};
    --kerb: {{ s.color_kerb }};
    --line: color-mix(in srgb, var(--text) 10%, transparent);
    --line-strong: color-mix(in srgb, var(--text) 18%, transparent);
    --display: "Saira Condensed","Arial Narrow",Impact,sans-serif;
    --mono: "Chakra Petch",Menlo,Consolas,monospace;
    --body: "Barlow","Helvetica Neue",Helvetica,Arial,sans-serif;
    position:relative;isolation:isolate;
    background:var(--bg);color:var(--text);font-family:var(--body);font-size:16px;line-height:1.55;
    -webkit-font-smoothing:antialiased;
    padding:{{ s.pad_top }}px 0 {{ s.pad_bottom }}px;
  }
  {%- if s.show_pattern -%}
  #rgp-{{ sid }}::before{
    content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:
      radial-gradient(1100px 520px at 85% -8%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 70%),
      radial-gradient(900px 600px at -10% 40%, color-mix(in srgb, var(--kerb) 7%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px) 0 0/48px 48px,
      linear-gradient(90deg, color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px) 0 0/48px 48px;
    -webkit-mask-image:linear-gradient(to bottom,#000 0,#000 60%,transparent 100%);
    mask-image:linear-gradient(to bottom,#000 0,#000 60%,transparent 100%);
  }
  {%- endif -%}
  #rgp-{{ sid }} *,#rgp-{{ sid }} *::before,#rgp-{{ sid }} *::after{box-sizing:border-box}
  #rgp-{{ sid }} img{display:block;max-width:100%;height:auto}
  #rgp-{{ sid }} a{color:inherit}
  #rgp-{{ sid }} button,#rgp-{{ sid }} input{font:inherit;color:inherit;letter-spacing:inherit}
  #rgp-{{ sid }} :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  #rgp-{{ sid }} .rgp-wrap{max-width:{{ s.max_width }}px;margin:0 auto;padding-inline:clamp(16px,3vw,40px)}
  #rgp-{{ sid }} .rgp-vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  /* Ruta */
  #rgp-{{ sid }} .rgp-crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 clamp(18px,2.4vw,30px);padding:0;list-style:none;font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  #rgp-{{ sid }} .rgp-crumbs a{text-decoration:none}
  #rgp-{{ sid }} .rgp-crumbs a:hover{color:var(--accent)}
  #rgp-{{ sid }} .rgp-crumbs li+li::before{content:"/";margin-right:8px;color:var(--line-strong)}
  #rgp-{{ sid }} .rgp-crumbs [aria-current]{color:var(--text);max-width:40ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  /* Rejilla principal */
  #rgp-{{ sid }} .rgp-main{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:clamp(28px,4.5vw,72px);align-items:start}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-main{grid-template-columns:1fr}}

  /* Galería */
  #rgp-{{ sid }} .rgp-gallery{position:sticky;top:calc(var(--header-height,72px) + 20px);display:grid;grid-template-columns:78px minmax(0,1fr);gap:14px}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-gallery{position:static;grid-template-columns:1fr}}
  #rgp-{{ sid }} .rgp-stage{
    position:relative;grid-column:2;aspect-ratio:1/1;border-radius:{{ s.radius }}px;overflow:hidden;
    background:radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--text) 13%, var(--surface)) 0%, var(--surface) 48%, color-mix(in srgb, #000 35%, var(--bg)) 100%);
    border:1px solid var(--line);
    box-shadow:0 1px 0 color-mix(in srgb, var(--text) 8%, transparent) inset, 0 40px 80px -30px rgba(0,0,0,.7);
  }
  @media (max-width:989px){#rgp-{{ sid }} .rgp-stage{grid-column:1}}
  #rgp-{{ sid }} .rgp-stage::before{
    content:"";position:absolute;inset:0;pointer-events:none;opacity:.5;
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,.028) 0 2px, transparent 2px 6px),
      repeating-linear-gradient(-45deg, rgba(0,0,0,.22) 0 2px, transparent 2px 6px);
    -webkit-mask-image:radial-gradient(circle at 50% 45%, transparent 30%, #000 75%);
    mask-image:radial-gradient(circle at 50% 45%, transparent 30%, #000 75%);
  }
  #rgp-{{ sid }} .rgp-stage::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;z-index:3;background:repeating-linear-gradient(115deg,var(--kerb) 0 22px,#EDEAE4 22px 44px)}
  #rgp-{{ sid }} .rgp-corner{position:absolute;z-index:3;width:22px;height:22px;border:2px solid var(--accent);pointer-events:none;opacity:.9}
  #rgp-{{ sid }} .rgp-corner--tl{top:16px;left:16px;border-right:0;border-bottom:0}
  #rgp-{{ sid }} .rgp-corner--tr{top:16px;right:16px;border-left:0;border-bottom:0}
  #rgp-{{ sid }} .rgp-corner--bl{bottom:24px;left:16px;border-right:0;border-top:0}
  #rgp-{{ sid }} .rgp-corner--br{bottom:24px;right:16px;border-left:0;border-top:0}
  #rgp-{{ sid }} .rgp-track{position:absolute;inset:0;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;overscroll-behavior-x:contain}
  #rgp-{{ sid }} .rgp-track::-webkit-scrollbar{display:none}
  #rgp-{{ sid }} .rgp-slide{flex:0 0 100%;height:100%;scroll-snap-align:center;display:grid;place-items:center;padding:clamp(28px,7%,64px) clamp(28px,7%,64px) calc(clamp(28px,7%,64px) + 6px);margin:0;cursor:zoom-in;background:none;border:0}
  #rgp-{{ sid }} .rgp-slide img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;border-radius:calc({{ s.radius }}px * .6);box-shadow:0 28px 50px -18px rgba(0,0,0,.75),0 0 0 1px rgba(255,255,255,.06)}
  #rgp-{{ sid }} .rgp-nav{position:absolute;top:50%;z-index:4;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;display:grid;place-items:center;cursor:pointer;background:color-mix(in srgb, var(--bg) 78%, transparent);border:1px solid var(--line-strong);color:var(--text);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);transition:background .2s,color .2s,border-color .2s}
  #rgp-{{ sid }} .rgp-nav:hover{background:var(--accent);border-color:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-nav--prev{left:16px}#rgp-{{ sid }} .rgp-nav--next{right:16px}
  #rgp-{{ sid }} .rgp-count{position:absolute;z-index:4;left:50%;bottom:22px;transform:translateX(-50%);font-family:var(--mono);font-size:12px;letter-spacing:.18em;padding:5px 12px;border-radius:999px;background:color-mix(in srgb, var(--bg) 82%, transparent);border:1px solid var(--line);font-variant-numeric:tabular-nums}
  #rgp-{{ sid }} .rgp-count b{color:var(--accent);font-weight:600}
  #rgp-{{ sid }} .rgp-zoom-hint{position:absolute;z-index:4;top:18px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);display:flex;gap:8px;align-items:center;opacity:.8}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-nav,#rgp-{{ sid }} .rgp-zoom-hint{display:none}}
  #rgp-{{ sid }} .rgp-thumbs{grid-column:1;grid-row:1;display:flex;flex-direction:column;gap:10px;max-height:min(80vh,720px);overflow-y:auto;scrollbar-width:none;padding:2px}
  #rgp-{{ sid }} .rgp-thumbs::-webkit-scrollbar{display:none}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-thumbs{grid-row:2;flex-direction:row;overflow-x:auto;max-height:none}}
  #rgp-{{ sid }} .rgp-thumb{flex:0 0 auto;width:74px;height:74px;padding:0;border-radius:6px;overflow:hidden;cursor:pointer;background:var(--surface);border:1px solid var(--line);opacity:.55;transition:opacity .2s,border-color .2s,transform .2s}
  #rgp-{{ sid }} .rgp-thumb:hover{opacity:.9}
  #rgp-{{ sid }} .rgp-thumb[aria-current="true"]{opacity:1;border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}
  #rgp-{{ sid }} .rgp-thumb img{width:100%;height:100%;object-fit:cover}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-thumb{width:62px;height:62px}}

  /* Información */
  #rgp-{{ sid }} .rgp-info{display:flex;flex-direction:column;gap:22px;min-width:0}
  #rgp-{{ sid }} .rgp-kicker{display:flex;align-items:center;gap:12px;margin:0;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}
  #rgp-{{ sid }} .rgp-kicker::before{content:"";width:28px;height:2px;background:var(--accent)}
  #rgp-{{ sid }} .rgp-kicker a{text-decoration:none}
  #rgp-{{ sid }} .rgp-kicker a:hover{text-decoration:underline}
  #rgp-{{ sid }} .rgp-kicker span{color:var(--muted)}
  #rgp-{{ sid }} .rgp-title{margin:0;font-family:var(--display);font-style:italic;font-weight:900;text-transform:uppercase;font-size:clamp(36px,4.4vw,{{ s.title_size }}px);line-height:.92;letter-spacing:-.005em;color:var(--text);text-wrap:balance}
  #rgp-{{ sid }} .rgp-title em{font-style:inherit;color:var(--accent)}
  #rgp-{{ sid }} .rgp-intro{margin:0;color:var(--muted);font-size:17px;max-width:60ch}
  #rgp-{{ sid }} .rgp-intro p{margin:0}
  #rgp-{{ sid }} .rgp-intro strong{color:var(--text);font-weight:600}
  #rgp-{{ sid }} .rgp-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}
  #rgp-{{ sid }} .rgp-chips li{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;padding:6px 10px;border-radius:3px;border:1px solid var(--line-strong);color:var(--muted)}

  #rgp-{{ sid }} .rgp-pricebox{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px 20px;border-radius:{{ s.radius }}px;background:color-mix(in srgb, var(--surface) 88%, transparent);border:1px solid var(--line);position:relative;overflow:hidden}
  #rgp-{{ sid }} .rgp-pricebox::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent)}
  #rgp-{{ sid }} .rgp-price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
  #rgp-{{ sid }} .rgp-price__now{font-family:var(--mono);font-weight:600;font-size:clamp(32px,3vw,40px);line-height:1;font-variant-numeric:tabular-nums}
  #rgp-{{ sid }} .rgp-price__was{font-family:var(--mono);color:var(--muted);text-decoration:line-through;font-size:18px}
  #rgp-{{ sid }} .rgp-price__save{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.1em;padding:4px 8px;border-radius:3px;background:var(--kerb);color:#fff}
  #rgp-{{ sid }} .rgp-price__tax{display:block;margin-top:6px;font-size:13px;color:var(--muted)}
  #rgp-{{ sid }} .rgp-stock{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600}
  #rgp-{{ sid }} .rgp-stock i{width:8px;height:8px;border-radius:50%;background:#3DDC84;box-shadow:0 0 0 4px color-mix(in srgb,#3DDC84 20%,transparent)}
  #rgp-{{ sid }} .rgp-stock[data-off] i{background:var(--kerb);box-shadow:0 0 0 4px color-mix(in srgb,var(--kerb) 20%,transparent)}

  #rgp-{{ sid }} .rgp-options{display:flex;flex-direction:column;gap:20px}
  #rgp-{{ sid }} .rgp-option{border:0;margin:0;padding:0;min-width:0}
  #rgp-{{ sid }} .rgp-option legend{display:flex;gap:10px;align-items:baseline;padding:0;margin:0 0 12px;font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
  #rgp-{{ sid }} .rgp-option legend b{font-family:var(--body);font-size:15px;letter-spacing:0;text-transform:none;color:var(--text)}
  #rgp-{{ sid }} .rgp-pills{display:flex;flex-wrap:wrap;gap:8px}
  #rgp-{{ sid }} .rgp-pill{position:relative}
  #rgp-{{ sid }} .rgp-pill input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  #rgp-{{ sid }} .rgp-pill span{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:10px 18px;border-radius:4px;border:1px solid var(--line-strong);background:color-mix(in srgb, var(--surface) 80%, transparent);font-weight:600;font-size:15px;transition:border-color .15s,background .15s,color .15s;cursor:pointer}
  #rgp-{{ sid }} .rgp-pill:hover span{border-color:color-mix(in srgb, var(--accent) 60%, transparent)}
  #rgp-{{ sid }} .rgp-pill input:checked + span{background:var(--accent);border-color:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-pill input:focus-visible + span{outline:2px solid var(--accent);outline-offset:3px}
  #rgp-{{ sid }} .rgp-pill .rgp-dot{width:12px;height:12px;border-radius:50%;border:1px solid rgba(255,255,255,.35)}

  #rgp-{{ sid }} .rgp-buy{display:flex;flex-direction:column;gap:10px}
  #rgp-{{ sid }} .rgp-buy__row{display:flex;gap:10px}
  #rgp-{{ sid }} .rgp-qty{display:inline-flex;align-items:center;flex:0 0 auto;height:56px;border:1px solid var(--line-strong);border-radius:4px;background:color-mix(in srgb, var(--surface) 80%, transparent)}
  #rgp-{{ sid }} .rgp-qty button{width:44px;height:100%;background:none;border:0;cursor:pointer;font-size:20px;color:var(--text)}
  #rgp-{{ sid }} .rgp-qty button:hover{color:var(--accent)}
  #rgp-{{ sid }} .rgp-qty input{width:44px;height:100%;text-align:center;background:transparent;border:0;font-family:var(--mono);font-weight:600;font-size:16px;-moz-appearance:textfield;appearance:textfield}
  #rgp-{{ sid }} .rgp-qty input::-webkit-outer-spin-button,#rgp-{{ sid }} .rgp-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  #rgp-{{ sid }} .rgp-btn{position:relative;flex:1;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:14px 24px;border-radius:4px;border:1px solid transparent;cursor:pointer;text-decoration:none;font-family:var(--body);font-weight:700;font-size:16px;letter-spacing:.04em;text-transform:uppercase;overflow:hidden;transition:filter .15s,transform .15s,background .15s,border-color .15s}
  #rgp-{{ sid }} .rgp-btn--primary{background:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-btn--primary::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.45) 50%,transparent 70%);transform:translateX(-120%);transition:transform .7s cubic-bezier(.16,1,.3,1)}
  #rgp-{{ sid }} .rgp-btn--primary:hover{filter:brightness(1.06)}
  #rgp-{{ sid }} .rgp-btn--primary:hover::after{transform:translateX(120%)}
  #rgp-{{ sid }} .rgp-btn--primary:active{transform:translateY(1px)}
  #rgp-{{ sid }} .rgp-btn[disabled]{opacity:.45;cursor:not-allowed;filter:none}
  #rgp-{{ sid }} .rgp-btn svg{flex:0 0 auto}
  #rgp-{{ sid }} .shopify-payment-button__button{min-height:52px!important;border-radius:4px!important;overflow:hidden}
  #rgp-{{ sid }} .shopify-payment-button__button--unbranded{background:transparent!important;color:var(--text)!important;border:1px solid var(--line-strong)!important;font-family:var(--body)!important;font-weight:700!important;letter-spacing:.04em!important;text-transform:uppercase}
  #rgp-{{ sid }} .shopify-payment-button__button--unbranded:hover:not([disabled]){border-color:var(--text)!important;background:color-mix(in srgb, var(--text) 6%, transparent)!important}
  #rgp-{{ sid }} .shopify-payment-button__more-options{color:var(--muted)!important;font-size:13px}
  #rgp-{{ sid }} .rgp-sku{font-family:var(--mono);font-size:12px;letter-spacing:.12em;color:var(--muted)}

  #rgp-{{ sid }} .rgp-vin{display:flex;gap:14px;align-items:flex-start;padding:16px 18px;border-radius:{{ s.radius }}px;background:color-mix(in srgb, var(--accent) 8%, var(--surface));border:1px solid color-mix(in srgb, var(--accent) 30%, transparent)}
  #rgp-{{ sid }} .rgp-vin svg{flex:0 0 auto;color:var(--accent);margin-top:2px}
  #rgp-{{ sid }} .rgp-vin b{display:block;font-size:15px}
  #rgp-{{ sid }} .rgp-vin p{margin:2px 0 0;font-size:14px;color:var(--muted)}

  #rgp-{{ sid }} .rgp-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:0;padding:0;list-style:none;border-radius:{{ s.radius }}px;overflow:hidden;background:var(--line);border:1px solid var(--line)}
  #rgp-{{ sid }} .rgp-trust li{display:flex;flex-direction:column;gap:6px;padding:16px;background:var(--bg);font-size:13px;color:var(--muted)}
  #rgp-{{ sid }} .rgp-trust svg{color:var(--accent);margin-bottom:4px}
  #rgp-{{ sid }} .rgp-trust b{color:var(--text);font-size:14px}
  @media (max-width:520px){#rgp-{{ sid }} .rgp-trust{grid-template-columns:1fr}#rgp-{{ sid }} .rgp-trust li{flex-direction:row;flex-wrap:wrap;align-items:center;column-gap:10px}#rgp-{{ sid }} .rgp-trust li span{flex-basis:100%;padding-left:32px}}

  /* Detalles */
  #rgp-{{ sid }} .rgp-details{margin-top:clamp(48px,7vw,96px);display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.6fr);gap:clamp(24px,5vw,80px);align-items:start}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-details{grid-template-columns:1fr}}
  #rgp-{{ sid }} .rgp-h2{margin:0;font-family:var(--display);font-style:italic;font-weight:900;text-transform:uppercase;font-size:clamp(34px,4vw,56px);line-height:.95}
  #rgp-{{ sid }} .rgp-details__side{position:sticky;top:calc(var(--header-height,72px) + 24px);display:flex;flex-direction:column;gap:14px}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-details__side{position:static}}
  #rgp-{{ sid }} .rgp-details__side p{margin:0;color:var(--muted);max-width:42ch}
  #rgp-{{ sid }} .rgp-acc{border-top:1px solid var(--line)}
  #rgp-{{ sid }} .rgp-acc > details{border-bottom:1px solid var(--line)}
  #rgp-{{ sid }} .rgp-acc > details > summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:18px;align-items:center;padding:22px 4px;cursor:pointer;list-style:none}
  #rgp-{{ sid }} .rgp-acc > details > summary::-webkit-details-marker{display:none}
  #rgp-{{ sid }} .rgp-acc__n{font-family:var(--mono);font-size:13px;font-weight:600;color:var(--accent);letter-spacing:.1em}
  #rgp-{{ sid }} .rgp-acc__t{font-family:var(--display);font-weight:700;font-size:clamp(22px,2vw,28px);line-height:1.05;text-transform:uppercase}
  #rgp-{{ sid }} .rgp-acc__i{width:34px;height:34px;border-radius:50%;border:1px solid var(--line-strong);display:grid;place-items:center;transition:transform .3s,background .2s,border-color .2s,color .2s}
  #rgp-{{ sid }} .rgp-acc > details > summary:hover .rgp-acc__i{border-color:var(--accent);color:var(--accent)}
  #rgp-{{ sid }} .rgp-acc > details[open] > summary .rgp-acc__i{transform:rotate(45deg);background:var(--accent);border-color:var(--accent);color:#1A1400}
  #rgp-{{ sid }} .rgp-acc__body{padding:0 4px 28px calc(4px + 18px + 2ch);color:var(--muted);max-width:78ch}
  @media (max-width:560px){#rgp-{{ sid }} .rgp-acc__body{padding-left:4px}}
  #rgp-{{ sid }} .rgp-acc__body p{margin:0 0 12px}
  #rgp-{{ sid }} .rgp-acc__body strong{color:var(--text);font-weight:600}
  #rgp-{{ sid }} .rgp-acc__body ul{margin:0 0 12px;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px}
  #rgp-{{ sid }} .rgp-acc__body li{position:relative;padding-left:22px}
  #rgp-{{ sid }} .rgp-acc__body li::before{content:"";position:absolute;left:0;top:.62em;width:10px;height:2px;background:var(--accent)}
  #rgp-{{ sid }} .rgp-acc__body details{margin:8px 0;border:1px solid var(--line);border-radius:6px;background:color-mix(in srgb, var(--surface) 85%, transparent)}
  #rgp-{{ sid }} .rgp-acc__body details summary{cursor:pointer;padding:14px 16px;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:center;color:var(--text)}
  #rgp-{{ sid }} .rgp-acc__body details summary::-webkit-details-marker{display:none}
  #rgp-{{ sid }} .rgp-acc__body details summary::after{content:"+";font-family:var(--mono);color:var(--accent);font-size:20px;line-height:1}
  #rgp-{{ sid }} .rgp-acc__body details[open] summary::after{content:"–"}
  #rgp-{{ sid }} .rgp-acc__body details p{padding:0 16px 14px;margin:0}

  /* Relacionados */
  #rgp-{{ sid }} .rgp-related{margin-top:clamp(56px,8vw,110px)}
  #rgp-{{ sid }} .rgp-related__head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:24px}
  #rgp-{{ sid }} .rgp-link{display:inline-flex;gap:8px;align-items:center;font-weight:700;text-decoration:none;color:var(--accent)}
  #rgp-{{ sid }} .rgp-link:hover{text-decoration:underline}
  #rgp-{{ sid }} .rgp-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
  @media (max-width:989px){#rgp-{{ sid }} .rgp-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}}
  #rgp-{{ sid }} .rgp-card{position:relative;display:flex;flex-direction:column;border-radius:{{ s.radius }}px;overflow:hidden;text-decoration:none;background:var(--surface);border:1px solid var(--line);transition:border-color .2s,transform .2s}
  #rgp-{{ sid }} .rgp-card::after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(115deg,var(--kerb) 0 20px,#EDEAE4 20px 40px);transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(.16,1,.3,1)}
  #rgp-{{ sid }} .rgp-card:hover{border-color:var(--accent);transform:translateY(-3px)}
  #rgp-{{ sid }} .rgp-card:hover::after{transform:scaleX(1)}
  #rgp-{{ sid }} .rgp-card__img{aspect-ratio:1/1;overflow:hidden;background:#E9E8E4}
  #rgp-{{ sid }} .rgp-card__img img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.16,1,.3,1)}
  #rgp-{{ sid }} .rgp-card:hover .rgp-card__img img{transform:scale(1.05)}
  #rgp-{{ sid }} .rgp-card__body{display:flex;flex-direction:column;gap:8px;padding:14px 16px 20px;flex:1}
  #rgp-{{ sid }} .rgp-card__t{margin:0;font-weight:600;font-size:15px;line-height:1.3}
  #rgp-{{ sid }} .rgp-card__p{margin-top:auto;font-family:var(--mono);font-weight:600;font-size:17px}
  #rgp-{{ sid }} .rgp-card__p small{font-family:var(--body);font-weight:500;font-size:12px;color:var(--muted);margin-right:4px}

  /* Barra fija de compra */
  #rgp-{{ sid }} .rgp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:30;transform:translateY(110%);transition:transform .35s cubic-bezier(.16,1,.3,1);background:color-mix(in srgb, var(--bg) 92%, transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--line-strong)}
  #rgp-{{ sid }} .rgp-sticky[data-show]{transform:none}
  #rgp-{{ sid }} .rgp-sticky::before{content:"";position:absolute;left:0;right:0;top:-4px;height:3px;background:repeating-linear-gradient(115deg,var(--kerb) 0 18px,#EDEAE4 18px 36px)}
  #rgp-{{ sid }} .rgp-sticky__in{display:flex;align-items:center;gap:16px;padding-block:10px}
  #rgp-{{ sid }} .rgp-sticky img{width:48px;height:48px;border-radius:4px;object-fit:cover;flex:0 0 auto}
  #rgp-{{ sid }} .rgp-sticky__t{min-width:0;flex:1;display:flex;flex-direction:column}
  #rgp-{{ sid }} .rgp-sticky__t b{font-weight:600;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #rgp-{{ sid }} .rgp-sticky__t span{font-family:var(--mono);font-weight:600;color:var(--accent)}
  #rgp-{{ sid }} .rgp-sticky .rgp-btn{flex:0 0 auto;min-height:48px;padding:10px 22px;font-size:14px}
  @media (max-width:560px){#rgp-{{ sid }} .rgp-sticky img{display:none}#rgp-{{ sid }} .rgp-sticky .rgp-btn{padding:10px 16px}}

  /* Visor ampliado */
  #rgp-{{ sid }} .rgp-lightbox{padding:0;border:0;background:transparent;max-width:100vw;max-height:100vh;width:100vw;height:100vh;color:var(--text)}
  #rgp-{{ sid }} .rgp-lightbox::backdrop{background:rgba(8,9,10,.92);backdrop-filter:blur(4px)}
  #rgp-{{ sid }} .rgp-lightbox__in{position:relative;width:100%;height:100%;display:grid;place-items:center;padding:clamp(16px,4vw,56px)}
  #rgp-{{ sid }} .rgp-lightbox img{max-width:100%;max-height:100%;object-fit:contain;border-radius:6px}
  #rgp-{{ sid }} .rgp-lightbox .rgp-nav{position:fixed}
  #rgp-{{ sid }} .rgp-close{position:fixed;top:16px;right:16px;z-index:5;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;cursor:pointer;background:var(--accent);border:0;color:#1A1400}

  /* Entrada animada */
  @media (prefers-reduced-motion:no-preference){
    #rgp-{{ sid }} [data-rgp-reveal]{opacity:0;transform:translateY(18px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
    #rgp-{{ sid }} [data-rgp-reveal].is-in{opacity:1;transform:none}
  }
  @media (prefers-reduced-motion:reduce){
    #rgp-{{ sid }} *{transition:none!important;scroll-behavior:auto!important}
  }
</style>

<div id="rgp-{{ sid }}" data-rgp data-currency="{{ cart.currency.iso_code }}">
  <div class="rgp-wrap">
    <nav aria-label="Ruta">
      <ol class="rgp-crumbs">
        <li><a href="{{ routes.root_url }}">Inicio</a></li>
        {%- if crumb_coll -%}<li><a href="{{ crumb_coll.url }}">{{ crumb_coll.title }}</a></li>{%- endif -%}
        <li><span aria-current="page">{{ product.title }}</span></li>
      </ol>
    </nav>

    <div class="rgp-main">
      {%- comment -%} Galería {%- endcomment -%}
      <div class="rgp-gallery" data-rgp-gallery>
        <div class="rgp-stage">
          <span class="rgp-corner rgp-corner--tl" aria-hidden="true"></span>
          <span class="rgp-corner rgp-corner--tr" aria-hidden="true"></span>
          <span class="rgp-corner rgp-corner--bl" aria-hidden="true"></span>
          <span class="rgp-corner rgp-corner--br" aria-hidden="true"></span>
          {%- if product.media.size > 0 -%}
            <div class="rgp-track" data-rgp-track tabindex="0" aria-label="Fotos de {{ product.title | escape }}">
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <button type="button" class="rgp-slide" data-rgp-slide data-media-id="{{ media.id }}" data-full="{{ media | image_url: width: 2000 }}" aria-label="Ampliar foto {{ forloop.index }}">
                    {%- if forloop.first -%}
                      {{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, fetchpriority: 'high' }}
                    {%- else -%}
                      {{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title, loading: 'lazy' }}
                    {%- endif -%}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if product.media.size > 1 -%}
              <span class="rgp-zoom-hint" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4M11 8v6M8 11h6"/></svg>{{ s.zoom_hint }}
              </span>
              <button type="button" class="rgp-nav rgp-nav--prev" data-rgp-prev aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
              <button type="button" class="rgp-nav rgp-nav--next" data-rgp-next aria-label="Foto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
              <span class="rgp-count" aria-live="polite"><b data-rgp-idx>01</b> / {{ product.media.size | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
          {%- else -%}
            <div class="rgp-track"><div class="rgp-slide">{{ 'product-1' | placeholder_svg_tag }}</div></div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="rgp-thumbs" role="group" aria-label="Miniaturas">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button type="button" class="rgp-thumb" data-rgp-thumb aria-label="Ver foto {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ media | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Información y compra {%- endcomment -%}
      <div class="rgp-info">
        <div style="display:flex;flex-direction:column;gap:14px">
          {%- if brand_coll -%}
            <p class="rgp-kicker"><a href="{{ brand_coll.url }}">{{ brand_coll.title }}</a>{%- if series_coll -%}<span>·</span><a href="{{ series_coll.url }}">{{ series_coll.title | remove: brand_coll.title | strip | default: series_coll.title }}</a>{%- endif -%}</p>
          {%- endif -%}
          {%- assign title_parts = product.title | split: ' · ' -%}
          <h1 class="rgp-title">
            {%- if title_parts.size > 1 -%}{{ title_parts.first }} <em>{{ title_parts.last }}</em>{%- else -%}{{ product.title }}{%- endif -%}
          </h1>
        </div>

        {%- if s.show_intro and intro != blank -%}
          <div class="rgp-intro">{{ intro }}</div>
        {%- endif -%}

        {%- if s.show_chips -%}
          <ul class="rgp-chips" aria-label="Características">
            {%- for tag in product.tags -%}
              {%- unless tag == 'Volante' -%}<li>{{ tag }}</li>{%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="rgp-pricebox">
          <div>
            <div class="rgp-price">
              <span class="rgp-price__now" data-rgp-price>{{ current.price | money }}</span>
              <s class="rgp-price__was" data-rgp-was {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{{ current.compare_at_price | money }}</s>
              <span class="rgp-price__save" data-rgp-save {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{%- if current.compare_at_price > current.price -%}−{{ current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price }}%{%- endif -%}</span>
            </div>
            <span class="rgp-price__tax">{{ s.tax_text }}</span>
          </div>
          <span class="rgp-stock" data-rgp-stock {% unless current.available %}data-off{% endunless %}><i aria-hidden="true"></i><span data-rgp-stock-label>{% if current.available %}{{ s.available_text }}{% else %}Agotado{% endif %}</span></span>
        </div>

        {%- assign form_id = 'rgp-form-' | append: sid -%}
        {%- form 'product', product, id: form_id, class: 'rgp-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-rgp-id>

          {%- unless product.has_only_default_variant -%}
            <div class="rgp-options" style="margin-bottom:22px">
              {%- for option in product.options_with_values -%}
                <fieldset class="rgp-option" data-rgp-option>
                  <legend>{{ option.name }} <b data-rgp-selected>{{ option.selected_value }}</b></legend>
                  <div class="rgp-pills">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign dot = ''
                        case value
                          when 'Roja', 'Rojo'
                            assign dot = '#D8342A'
                          when 'Azul'
                            assign dot = '#2D6BD8'
                          when 'Blanca', 'Blanco'
                            assign dot = '#F1EFEA'
                          when 'Amarilla', 'Amarillo'
                            assign dot = '#FFC21A'
                          when 'Negro', 'Negra'
                            assign dot = '#0B0B0C'
                          when 'Beige'
                            assign dot = '#D9C7A6'
                          when 'Gris'
                            assign dot = '#8A9097'
                          when 'Burdeos'
                            assign dot = '#6E1E2B'
                          when 'Marrón'
                            assign dot = '#6B4226'
                        endcase
                      -%}
                      <label class="rgp-pill">
                        <input type="radio" name="rgp-{{ sid }}-opt-{{ forloop.parentloop.index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span>{%- if dot != '' -%}<i class="rgp-dot" style="background:{{ dot }}" aria-hidden="true"></i>{%- endif -%}{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="rgp-buy">
            <div class="rgp-buy__row">
              <div class="rgp-qty">
                <button type="button" data-rgp-step="-1" aria-label="Quitar uno">−</button>
                <label class="rgp-vh" for="rgp-qty-{{ sid }}">Cantidad</label>
                <input id="rgp-qty-{{ sid }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                <button type="button" data-rgp-step="1" aria-label="Añadir uno">+</button>
              </div>
              <button class="rgp-btn rgp-btn--primary" type="submit" name="add" data-rgp-add data-label="{{ s.add_label | escape }}" {% unless current.available %}disabled{% endunless %}>
                <span data-rgp-add-label>{%- if current.available -%}{{ s.add_label }}{%- else -%}Agotado{%- endif -%}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            {%- if s.show_buy_now -%}{{ form | payment_button }}{%- endif -%}
          </div>
        {%- endform -%}

        {%- if s.vin_title != blank -%}
          <div class="rgp-vin">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-4z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
            <div><b>{{ s.vin_title }}</b>{%- if s.vin_text != blank -%}<p>{{ s.vin_text }}</p>{%- endif -%}</div>
          </div>
        {%- endif -%}

        {%- if s.show_trust -%}
          <ul class="rgp-trust">
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M3.5 10.5l6 1M20.5 10.5l-6 1M12 14.5V21"/></svg><b>{{ s.trust_1_title }}</b><span>{{ s.trust_1_text }}</span></li>
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg><b>{{ s.trust_2_title }}</b><span>{{ s.trust_2_text }}</span></li>
            <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><b>{{ s.trust_3_title }}</b><span>{{ s.trust_3_text }}</span></li>
          </ul>
        {%- endif -%}

        <span class="rgp-sku" data-rgp-sku>{% if current.sku != blank %}REF. {{ current.sku }}{% endif %}</span>
      </div>
    </div>

    {%- comment -%} Detalles: cada bloque «h3» de la descripción se convierte en un desplegable {%- endcomment -%}
    {%- if desc_parts.size > 1 -%}
      <section class="rgp-details" data-rgp-reveal aria-labelledby="rgp-det-{{ sid }}">
        <div class="rgp-details__side">
          <p class="rgp-kicker">{{ s.details_kicker }}</p>
          <h2 class="rgp-h2" id="rgp-det-{{ sid }}">{{ s.details_title }}</h2>
          {%- if s.details_text != blank -%}<p>{{ s.details_text }}</p>{%- endif -%}
        </div>
        <div class="rgp-acc">
          {%- for part in desc_parts offset: 1 -%}
            {%- assign bits = part | split: '</h3>' -%}
            {%- assign heading = bits.first | strip_html | strip -%}
            {%- assign body = part | remove_first: bits.first | remove_first: '</h3>' -%}
            <details {% if forloop.first and s.open_first %}open{% endif %}>
              <summary>
                <span class="rgp-acc__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="rgp-acc__t">{{ heading }}</span>
                <span class="rgp-acc__i" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <div class="rgp-acc__body">{{ body }}</div>
            </details>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} Relacionados de la misma marca {%- endcomment -%}
    {%- if s.show_related and brand_coll and brand_coll.products_count > 1 -%}
      <section class="rgp-related" data-rgp-reveal aria-labelledby="rgp-rel-{{ sid }}">
        <div class="rgp-related__head">
          <div>
            <p class="rgp-kicker">{{ s.related_kicker }}</p>
            <h2 class="rgp-h2" id="rgp-rel-{{ sid }}">{{ s.related_title | replace: '[marca]', brand_coll.title }}</h2>
          </div>
          <a class="rgp-link" href="{{ brand_coll.url }}">Ver todos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="rgp-grid">
          {%- assign shown = 0 -%}
          {%- for p in brand_coll.products -%}
            {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= s.related_count -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="rgp-card" href="{{ p.url }}">
              <div class="rgp-card__img">
                {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', alt: p.title }}{%- endif -%}
              </div>
              <div class="rgp-card__body">
                <h3 class="rgp-card__t">{{ p.title }}</h3>
                <span class="rgp-card__p">{%- if p.price_varies -%}<small>Desde</small>{%- endif -%}{{ p.price_min | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>

  {%- if s.show_sticky -%}
    <div class="rgp-sticky" data-rgp-sticky aria-hidden="true">
      <div class="rgp-wrap rgp-sticky__in">
        {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        <div class="rgp-sticky__t"><b>{{ product.title }}</b><span data-rgp-sticky-price>{{ current.price | money }}</span></div>
        <button type="button" class="rgp-btn rgp-btn--primary" data-rgp-sticky-btn tabindex="-1">{{ s.add_label }}</button>
      </div>
    </div>
  {%- endif -%}

  <dialog class="rgp-lightbox" data-rgp-lightbox aria-label="Foto ampliada">
    <div class="rgp-lightbox__in">
      <button type="button" class="rgp-close" data-rgp-close aria-label="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      <button type="button" class="rgp-nav rgp-nav--prev" data-rgp-lb-prev aria-label="Foto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
      <img data-rgp-lb-img alt="">
      <button type="button" class="rgp-nav rgp-nav--next" data-rgp-lb-next aria-label="Foto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </dialog>

  <script type="application/json" data-rgp-variants>{{ product.variants | json }}</script>
</div>

<script>
(() => {
  const root = document.getElementById('rgp-{{ sid }}');
  if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  const $ = (q, el = root) => el.querySelector(q);
  const $$ = (q, el = root) => [...el.querySelectorAll(q)];
  const pad = n => String(n).padStart(2, '0');
  const fmt = cents => {
    try { return new Intl.NumberFormat(document.documentElement.lang || 'es', { style: 'currency', currency: root.dataset.currency || 'EUR' }).format(cents / 100); }
    catch (e) { return (cents / 100).toFixed(2) + ' €'; }
  };

  /* Galería */
  const track = $('[data-rgp-track]');
  const slides = $$('[data-rgp-slide]');
  const thumbs = $$('[data-rgp-thumb]');
  const idxEl = $('[data-rgp-idx]');
  let cur = 0;
  const go = (n, smooth = true) => {
    if (!slides.length) return;
    cur = (n + slides.length) % slides.length;
    track.scrollTo({ left: slides[cur].offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
  };
  const mark = n => {
    cur = n;
    thumbs.forEach((t, k) => t.setAttribute('aria-current', k === n));
    if (idxEl) idxEl.textContent = pad(n + 1);
    const t = thumbs[n]; if (t) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };
  if (track && slides.length > 1) {
    let raf;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => mark(Math.round(track.scrollLeft / track.clientWidth))); }, { passive: true });
    $('[data-rgp-prev]')?.addEventListener('click', () => go(cur - 1));
    $('[data-rgp-next]')?.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    track.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); } if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); } });
  }
  const showMedia = id => { const k = slides.findIndex(s => s.dataset.mediaId === String(id)); if (k >= 0) go(k); };

  /* Visor ampliado */
  const lb = $('[data-rgp-lightbox]'); const lbImg = $('[data-rgp-lb-img]');
  let lbI = 0;
  const lbShow = n => { lbI = (n + slides.length) % slides.length; const s = slides[lbI]; lbImg.src = s.dataset.full; lbImg.alt = s.querySelector('img')?.alt || ''; };
  if (lb && lb.showModal) {
    slides.forEach((s, k) => s.addEventListener('click', () => { lbShow(k); lb.showModal(); }));
    $('[data-rgp-close]').addEventListener('click', () => lb.close());
    $('[data-rgp-lb-prev]').addEventListener('click', () => lbShow(lbI - 1));
    $('[data-rgp-lb-next]').addEventListener('click', () => lbShow(lbI + 1));
    lb.addEventListener('click', e => { if (e.target === lb || e.target.classList.contains('rgp-lightbox__in')) lb.close(); });
    lb.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') lbShow(lbI - 1); if (e.key === 'ArrowRight') lbShow(lbI + 1); });
    lb.addEventListener('close', () => go(lbI, false));
  }

  /* Variantes */
  const variants = JSON.parse($('[data-rgp-variants]').textContent);
  const form = $('form[action*="/cart/add"]');
  const idInput = $('[data-rgp-id]');
  const fieldsets = $$('[data-rgp-option]');
  const addBtn = $('[data-rgp-add]'); const addLabel = $('[data-rgp-add-label]');
  const priceEl = $('[data-rgp-price]'), wasEl = $('[data-rgp-was]'), saveEl = $('[data-rgp-save]');
  const stockEl = $('[data-rgp-stock]'), stockLabel = $('[data-rgp-stock-label]');
  const skuEl = $('[data-rgp-sku]'), stickyPrice = $('[data-rgp-sticky-price]'), stickyBtn = $('[data-rgp-sticky-btn]');
  const availText = {{ s.available_text | json }};
  const update = () => {
    const opts = fieldsets.map(fs => fs.querySelector('input:checked')?.value);
    fieldsets.forEach((fs, k) => { const l = fs.querySelector('[data-rgp-selected]'); if (l) l.textContent = opts[k] || ''; });
    const v = variants.find(v => v.options.every((o, k) => o === opts[k]));
    if (!v) { addBtn.disabled = true; addLabel.textContent = 'No disponible'; if (stickyBtn) stickyBtn.disabled = true; return; }
    idInput.value = v.id;
    priceEl.textContent = fmt(v.price);
    if (stickyPrice) stickyPrice.textContent = fmt(v.price);
    const sale = v.compare_at_price > v.price;
    wasEl.hidden = !sale; saveEl.hidden = !sale;
    if (sale) { wasEl.textContent = fmt(v.compare_at_price); saveEl.textContent = '−' + Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price) + '%'; }
    addBtn.disabled = !v.available; addLabel.textContent = v.available ? addBtn.dataset.label : 'Agotado';
    if (stickyBtn) stickyBtn.disabled = !v.available;
    stockEl.toggleAttribute('data-off', !v.available); stockLabel.textContent = v.available ? availText : 'Agotado';
    skuEl.textContent = v.sku ? 'REF. ' + v.sku : '';
    if (v.featured_media) showMedia(v.featured_media.id);
    const url = new URL(location.href); url.searchParams.set('variant', v.id); history.replaceState({}, '', url);
  };
  fieldsets.forEach(fs => fs.addEventListener('change', update));

  /* Cantidad */
  const q = $('.rgp-qty input');
  $$('[data-rgp-step]').forEach(b => b.addEventListener('click', () => { q.value = Math.max(1, (parseInt(q.value, 10) || 1) + parseInt(b.dataset.rgpStep, 10)); }));

  /* Barra fija */
  const sticky = $('[data-rgp-sticky]');
  if (sticky && addBtn && 'IntersectionObserver' in window) {
    const buy = $('.rgp-buy');
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      sticky.toggleAttribute('data-show', show); sticky.setAttribute('aria-hidden', !show);
      stickyBtn.tabIndex = show ? 0 : -1;
    }).observe(buy);
    stickyBtn.addEventListener('click', () => { if (form.requestSubmit) form.requestSubmit(addBtn); else addBtn.click(); });
  }

  /* Entrada animada */
  const rev = $$('[data-rgp-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    rev.forEach(el => io.observe(el));
  } else rev.forEach(el => el.classList.add('is-in'));
})();
</script>

