{%- comment -%} RacingGrip · Pie de página: marca, garantías, enlaces de ayuda y tienda, boletín, formas de pago y aviso de marcas. {%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}
{%- assign f_email = s.email | default: shop.email -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Condensed:ital,wght@0,700;1,800;1,900&family=Barlow:wght@400;500;600;700&family=Chakra+Petch:wght@500;600&display=swap">
<style>
  #rgf-{{ sid }}{--bg:{{ s.color_bg }};--surface:color-mix(in srgb, var(--text) 5%, var(--bg));--text:{{ s.color_text }};--muted:{{ s.color_muted }};--accent:{{ s.color_accent }};--kerb:{{ s.color_kerb }};
    --line:color-mix(in srgb, var(--text) 10%, transparent);position:relative;background:var(--bg);color:var(--text);
    font-family:"Barlow","Helvetica Neue",Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
  #rgf-{{ sid }} *{box-sizing:border-box}
  #rgf-{{ sid }}::before{content:"";display:block;height:6px;background:repeating-linear-gradient(115deg,var(--kerb) 0 22px,#EDEAE4 22px 44px)}
  #rgf-{{ sid }} .rgf-wrap{max-width:{{ s.max_width }}px;margin:0 auto;padding:0 clamp(16px,3vw,40px)}
  #rgf-{{ sid }} a{color:inherit;text-decoration:none}
  #rgf-{{ sid }} a:hover{color:var(--accent)}
  #rgf-{{ sid }} a:focus-visible,#rgf-{{ sid }} button:focus-visible,#rgf-{{ sid }} input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

  /* Franja de garantías */
  #rgf-{{ sid }} .rgf-trust{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:0;padding:0;list-style:none;border-bottom:1px solid var(--line);background:var(--line)}
  #rgf-{{ sid }} .rgf-trust li{display:flex;gap:14px;align-items:center;padding:22px clamp(14px,2vw,26px);background:var(--bg)}
  #rgf-{{ sid }} .rgf-trust svg{flex:0 0 auto;width:26px;height:26px;color:var(--accent)}
  #rgf-{{ sid }} .rgf-trust b{display:block;font-size:15px;line-height:1.2}
  #rgf-{{ sid }} .rgf-trust span{display:block;font-size:13px;color:var(--muted);line-height:1.35}

  /* Columnas */
  #rgf-{{ sid }} .rgf-main{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,.8fr)) minmax(0,1.3fr);gap:clamp(28px,4vw,56px);padding:clamp(40px,5vw,64px) 0}
  #rgf-{{ sid }} .rgf-logo{margin:0 0 12px;font-family:"Saira Condensed","Arial Narrow",Impact,sans-serif;font-style:italic;font-weight:900;font-size:40px;line-height:.9;text-transform:uppercase;letter-spacing:-.01em}
  #rgf-{{ sid }} .rgf-logo em{font-style:inherit;color:var(--accent)}
  #rgf-{{ sid }} .rgf-about{margin:0 0 16px;color:var(--muted);max-width:40ch}
  #rgf-{{ sid }} .rgf-contact{margin:0;padding:0;list-style:none;display:grid;gap:6px;font-size:14px;color:var(--muted)}
  #rgf-{{ sid }} .rgf-contact a{color:var(--text)}
  #rgf-{{ sid }} .rgf-h{margin:0 0 14px;font-family:"Chakra Petch",Menlo,monospace;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
  #rgf-{{ sid }} .rgf-links{margin:0;padding:0;list-style:none;display:grid;gap:9px;font-size:15px}
  #rgf-{{ sid }} .rgf-links a{color:color-mix(in srgb, var(--text) 85%, transparent)}
  #rgf-{{ sid }} .rgf-news p{margin:0 0 14px;color:var(--muted)}
  #rgf-{{ sid }} .rgf-field{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--surface)}
  #rgf-{{ sid }} .rgf-field input{flex:1;min-width:0;height:48px;padding:0 18px;border:0;background:transparent;color:var(--text);font:inherit}
  #rgf-{{ sid }} .rgf-field input::placeholder{color:var(--muted)}
  #rgf-{{ sid }} .rgf-field button{flex:0 0 auto;height:48px;padding:0 20px;border:0;background:var(--accent);color:#1A1400;font:700 14px/1 inherit;letter-spacing:.06em;text-transform:uppercase;cursor:pointer}
  #rgf-{{ sid }} .rgf-msg{margin:10px 0 0;font-size:13px}
  #rgf-{{ sid }} .rgf-msg--ok{color:#3DDC84}
  #rgf-{{ sid }} .rgf-msg--err{color:#FF6A5F}
  #rgf-{{ sid }} .rgf-legal-note{margin:10px 0 0;font-size:12px;color:var(--muted)}

  /* Barra inferior */
  #rgf-{{ sid }} .rgf-bottom{border-top:1px solid var(--line);padding:22px 0 28px;display:flex;flex-wrap:wrap;gap:14px 28px;align-items:center;justify-content:space-between;font-size:13px;color:var(--muted)}
  #rgf-{{ sid }} .rgf-bottom p{margin:0}
  #rgf-{{ sid }} .rgf-pay{display:flex;align-items:center}
  #rgf-{{ sid }} .rg-pay{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}
  #rgf-{{ sid }} .rg-pay li{display:block}
  #rgf-{{ sid }} .rg-pay__i{display:block;width:42px;height:28px;border-radius:4px;box-shadow:0 0 0 1px rgba(255,255,255,.12)}
  #rgf-{{ sid }} .rgf-disclaimer{flex-basis:100%;font-size:12px;line-height:1.5;opacity:.8}

  @media (max-width:989px){
    #rgf-{{ sid }} .rgf-trust{grid-template-columns:repeat(2,minmax(0,1fr))}
    #rgf-{{ sid }} .rgf-main{grid-template-columns:repeat(2,minmax(0,1fr))}
    #rgf-{{ sid }} .rgf-brand,#rgf-{{ sid }} .rgf-news{grid-column:1/-1}
  }
  @media (max-width:520px){
    #rgf-{{ sid }} .rgf-trust li{flex-direction:column;align-items:flex-start;gap:8px;padding:16px 14px}
  }
</style>
<footer id="rgf-{{ sid }}">
  <ul class="rgf-trust" role="list">
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg><div><b>Envío gratis</b><span>A toda Europa, en 10–15 días</span></div></li>
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-4z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><div><b>Garantía de 3 años</b><span>La garantía legal, siempre</span></div></li>
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M3.5 10.5l6 1M20.5 10.5l-6 1M12 14.5V21"/></svg><div><b>Hecho a medida</b><span>Compatibilidad verificada por bastidor</span></div></li>
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg><div><b>Pago seguro</b><span>IVA incluido, sin sorpresas</span></div></li>
  </ul>

  <div class="rgf-wrap">
    <div class="rgf-main">
      <div class="rgf-brand">
        <p class="rgf-logo notranslate" translate="no">Racing<em>Grip</em></p>
        {%- if s.about != blank -%}<p class="rgf-about">{{ s.about }}</p>{%- endif -%}
        <ul class="rgf-contact" role="list">
          {%- if f_email != blank -%}<li><a href="mailto:{{ f_email }}">{{ f_email }}</a></li>{%- endif -%}
          {%- if s.phone != blank -%}<li><a href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a></li>{%- endif -%}
          {%- if s.address != blank -%}<li>{{ s.address }}</li>{%- endif -%}
        </ul>
      </div>

      <nav aria-label="{{ s.shop_title | escape }}">
        <p class="rgf-h">{{ s.shop_title }}</p>
        <ul class="rgf-links" role="list">
          {%- for link in s.shop_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </nav>

      <nav aria-label="{{ s.help_title | escape }}">
        <p class="rgf-h">{{ s.help_title }}</p>
        <ul class="rgf-links" role="list">
          {%- for link in s.help_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </nav>

      <div class="rgf-news">
        <p class="rgf-h">{{ s.news_title }}</p>
        {%- if s.news_text != blank -%}<p>{{ s.news_text }}</p>{%- endif -%}
        {%- form 'customer', id: 'rgf-news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="rgf-field">
            <label for="rgf-email-{{ sid }}" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Correo electrónico</label>
            <input id="rgf-email-{{ sid }}" type="email" name="contact[email]" required autocomplete="email" placeholder="Tu correo electrónico">
            <button type="submit">Apuntarme</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="rgf-msg rgf-msg--ok" role="status">¡Gracias! Ya estás en la lista.</p>
          {%- elsif form.errors -%}
            <p class="rgf-msg rgf-msg--err" role="alert">Revisa el correo electrónico e inténtalo de nuevo.</p>
          {%- endif -%}
          <p class="rgf-legal-note">Solo te escribiremos con novedades y ofertas. Puedes darte de baja cuando quieras. <a href="/policies/privacy-policy" style="text-decoration:underline">Privacidad</a>.</p>
        {%- endform -%}
      </div>
    </div>

    <div class="rgf-bottom">
      <p>© {{ 'now' | date: '%Y' }} <span class="notranslate" translate="no">RacingGrip</span>. Todos los derechos reservados.</p>
      <div class="rgf-pay">{%- render 'rg-pagos', types: s.pay_types -%}</div>
      {%- if s.disclaimer != blank -%}<p class="rgf-disclaimer">{{ s.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "RG · Pie de página",
  "tag": "div",
  "class": "rg-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Marca y contacto" },
    { "type": "textarea", "id": "about", "label": "Texto de la marca", "default": "Volantes deportivos hechos a medida para BMW, Mercedes-Benz, Porsche y Volkswagen. Cuero napa, Alcántara y fibra de carbono." },
    { "type": "text", "id": "email", "label": "Correo", "info": "Si lo dejas vacío se usa el correo de la tienda." },
    { "type": "text", "id": "phone", "label": "Teléfono" },
    { "type": "text", "id": "address", "label": "Dirección" },
    { "type": "header", "content": "Enlaces" },
    { "type": "text", "id": "shop_title", "label": "Título columna tienda", "default": "Tienda" },
    { "type": "link_list", "id": "shop_menu", "label": "Menú de la tienda", "default": "main-menu" },
    { "type": "text", "id": "help_title", "label": "Título columna ayuda", "default": "Ayuda" },
    { "type": "link_list", "id": "help_menu", "label": "Menú de ayuda", "default": "footer" },
    { "type": "header", "content": "Boletín" },
    { "type": "text", "id": "news_title", "label": "Título", "default": "Novedades y ofertas" },
    { "type": "text", "id": "news_text", "label": "Texto", "default": "Apúntate y sé el primero en enterarte de nuevos modelos y promociones." },
    { "type": "header", "content": "Parte inferior" },
    { "type": "text", "id": "pay_types", "label": "Formas de pago (separadas por comas)", "default": "visa, master, apple_pay, google_pay, paypal" },
    { "type": "textarea", "id": "disclaimer", "label": "Aviso de marcas", "default": "BMW, Mercedes-Benz, AMG, Porsche y Volkswagen son marcas registradas de sus respectivos titulares. RacingGrip no está afiliada ni autorizada por ellos; las marcas se mencionan solo para indicar la compatibilidad." },
    { "type": "header", "content": "Colores y tamaño" },
    { "type": "color", "id": "color_bg", "label": "Fondo", "default": "#0E0F11" },
    { "type": "color", "id": "color_text", "label": "Texto", "default": "#F1EFEA" },
    { "type": "color", "id": "color_muted", "label": "Texto secundario", "default": "#9AA1A8" },
    { "type": "color", "id": "color_accent", "label": "Acento", "default": "#FFC21A" },
    { "type": "color", "id": "color_kerb", "label": "Bordillo (rojo)", "default": "#D8342A" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1400 }
  ],
  "presets": [{ "name": "RG · Pie de página" }]
}
{% endschema %}
