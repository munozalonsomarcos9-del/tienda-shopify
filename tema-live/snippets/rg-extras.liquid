{%- comment -%}
  RacingGrip · Casillas de extras opcionales de la ficha de producto.
  Lee la lista «Extras opcionales» de la descripción (part) y busca cada extra como producto oculto «extra-…».
  De ese producto usa la versión de la marca del volante (brand: BMW, Mercedes-Benz, Volkswagen o Porsche),
  así el precio de cada extra se cambia en un solo sitio.
  Solo pinta las casillas; los estilos y el JavaScript están en sections/rg-producto.liquid.
{%- endcomment -%}
{%- assign lis = part | split: '<li>' -%}
{%- for li in lis offset: 1 -%}
  {%- liquid
    assign txt = li | split: '</li>' | first | strip_html | strip
    if txt == ''
      continue
    endif
    assign ex_name = txt | split: '·' | first | strip
    assign ex_handle = ex_name | downcase | replace: 'á', 'a' | replace: 'é', 'e' | replace: 'í', 'i' | replace: 'ó', 'o' | replace: 'ú', 'u' | replace: 'ñ', 'n' | replace: 'ü', 'u' | handleize | prepend: 'extra-'
    assign ex_product = all_products[ex_handle]
    assign ex_variant = nil
    for ev in ex_product.variants
      if ev.title == brand
        assign ex_variant = ev
      endif
    endfor
    if ex_variant == nil
      continue
    endif
    assign ex_key = ex_name | downcase
  -%}
  <label class="rgp-extra">
    <input type="checkbox" value="{{ ex_variant.id }}" data-rgp-extra data-name="{{ ex_name | escape }}" data-price="{{ ex_variant.price }}">
    <span class="rgp-extra__ico" aria-hidden="true">
      {%- if ex_key contains 'calefac' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3c-1.5 2 1.5 3 0 5s1.5 3 0 5M12 3c-1.5 2 1.5 3 0 5s1.5 3 0 5M16 3c-1.5 2 1.5 3 0 5s1.5 3 0 5M4 19h16"/></svg>
      {%- elsif ex_key contains 'levas' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5L4 8v8l5 3M15 5l5 3v8l-5 3"/><circle cx="12" cy="12" r="3"/></svg>
      {%- elsif ex_key contains 'pantalla' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 12h2M11 12h2M15 12h2"/></svg>
      {%- elsif ex_key contains 'forjado' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 2l8.7 5v10L12 22l-8.7-5V7z"/><path d="M7 9l4 2M13 14l4-2M10 16l2-5"/></svg>
      {%- elsif ex_key contains 'alc' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7c3-2 5 2 8 0s5 2 8 0M4 12c3-2 5 2 8 0s5 2 8 0M4 17c3-2 5 2 8 0s5 2 8 0"/></svg>
      {%- elsif ex_key contains 'vibra' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M5 8a8 8 0 000 8M19 8a8 8 0 010 8M2 5a13 13 0 000 14M22 5a13 13 0 010 14"/></svg>
      {%- elsif ex_key contains 'crucero' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 16a8 8 0 1116 0"/><path d="M12 16l4-5"/><circle cx="12" cy="16" r="1.4" fill="currentColor"/></svg>
      {%- elsif ex_key contains 'bot' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 16V8l4 5 4-5v8"/></svg>
      {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      {%- endif -%}
    </span>
    <span class="rgp-extra__t">{{ ex_name }}</span>
    <span class="rgp-extra__p">+{{ ex_variant.price | money_without_trailing_zeros }}</span>
    <span class="rgp-extra__chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg></span>
  </label>
{%- endfor -%}
