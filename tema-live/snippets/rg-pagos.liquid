{%- comment -%}
  RacingGrip · Iconos de formas de pago.
  Recibe «types» (lista separada por comas, p. ej. «visa, master, paypal») o bien «s» (los ajustes
  de la sección que lo usa) con casillas pay_visa, pay_master, pay_maestro, pay_amex, pay_apple,
  pay_google y pay_paypal. Si «pay_auto» está marcado y Shopify tiene formas de pago activas, se
  muestran esas en su lugar.
  Se usa el logo oficial de Shopify; si Shopify no devuelve ninguno, se dibuja uno propio.
{%- endcomment -%}
{%- liquid
  assign pay = ''
  if s.pay_visa
    assign pay = pay | append: 'visa,'
  endif
  if s.pay_master
    assign pay = pay | append: 'master,'
  endif
  if s.pay_maestro
    assign pay = pay | append: 'maestro,'
  endif
  if s.pay_amex
    assign pay = pay | append: 'american_express,'
  endif
  if s.pay_apple
    assign pay = pay | append: 'apple_pay,'
  endif
  if s.pay_google
    assign pay = pay | append: 'google_pay,'
  endif
  if s.pay_paypal
    assign pay = pay | append: 'paypal,'
  endif
  if types != blank
    assign pay = types
  endif
  assign pay_list = pay | remove: ' ' | downcase | split: ','
  if s.pay_auto and shop.enabled_payment_types.size > 0
    assign pay_list = shop.enabled_payment_types
  endif
-%}
{%- if pay_list.size > 0 -%}
  <ul class="rg-pay" aria-label="Formas de pago aceptadas">
    {%- for pay_type in pay_list -%}
      {%- assign pt = pay_type | strip -%}
      {%- if pt == blank -%}{%- continue -%}{%- endif -%}
      {%- assign pt_svg = pt | payment_type_svg_tag: class: 'rg-pay__i' -%}
      <li>
        {%- if pt_svg != blank -%}
          {{ pt_svg }}
        {%- else -%}
          {%- case pt -%}
            {%- when 'visa' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="Visa"><rect width="38" height="24" rx="3" fill="#fff"/><text x="19" y="16.2" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="10.5" font-weight="900" font-style="italic" fill="#1A1F71" letter-spacing=".3">VISA</text></svg>
            {%- when 'master' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="Mastercard"><rect width="38" height="24" rx="3" fill="#fff"/><circle cx="15.5" cy="12" r="7" fill="#EB001B"/><circle cx="22.5" cy="12" r="7" fill="#F79E1B"/><path d="M19 5.9a7 7 0 010 12.2 7 7 0 010-12.2z" fill="#FF5F00"/></svg>
            {%- when 'maestro' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="Maestro"><rect width="38" height="24" rx="3" fill="#fff"/><circle cx="15.5" cy="12" r="7" fill="#EB001B"/><circle cx="22.5" cy="12" r="7" fill="#00A2E5"/><path d="M19 5.9a7 7 0 010 12.2 7 7 0 010-12.2z" fill="#7375CF"/></svg>
            {%- when 'american_express' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="American Express"><rect width="38" height="24" rx="3" fill="#1F72CD"/><text x="19" y="15.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="900" fill="#fff" letter-spacing=".4">AMEX</text></svg>
            {%- when 'apple_pay' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="Apple Pay"><rect width="38" height="24" rx="3" fill="#000"/><path fill="#fff" d="M11.3 8.4c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.4-.7 1.1-.6 1.8.7 0 1.3-.3 1.7-.8zm.6 1c-.9-.1-1.7.5-2.2.5-.4 0-1.1-.5-1.9-.5-1 0-1.9.6-2.4 1.5-1 1.8-.3 4.4.7 5.8.5.7 1 1.5 1.8 1.4.7 0 1-.5 1.8-.5.9 0 1.1.5 1.9.5s1.3-.7 1.7-1.4c.6-.8.8-1.6.8-1.6s-1.6-.6-1.6-2.4c0-1.5 1.2-2.2 1.3-2.3-.7-1-1.8-1.1-2.1-1.1z"/><text x="25.5" y="16" text-anchor="middle" font-family="-apple-system,Helvetica,Arial,sans-serif" font-size="8.6" font-weight="600" fill="#fff">Pay</text></svg>
            {%- when 'google_pay' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="Google Pay"><rect width="38" height="24" rx="3" fill="#fff"/><text x="6.5" y="16" font-family="Arial,Helvetica,sans-serif" font-size="9.5" font-weight="700"><tspan fill="#4285F4">G</tspan></text><text x="15" y="16" font-family="Arial,Helvetica,sans-serif" font-size="8.6" font-weight="600" fill="#5F6368">Pay</text></svg>
            {%- when 'paypal' -%}
              <svg class="rg-pay__i" viewBox="0 0 38 24" role="img" aria-label="PayPal"><rect width="38" height="24" rx="3" fill="#fff"/><text x="19" y="15.6" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.8" font-weight="900" font-style="italic"><tspan fill="#003087">Pay</tspan><tspan fill="#009CDE">Pal</tspan></text></svg>
            {%- else -%}
              <span class="rg-pay__txt">{{ pt | replace: '_', ' ' | capitalize }}</span>
          {%- endcase -%}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
